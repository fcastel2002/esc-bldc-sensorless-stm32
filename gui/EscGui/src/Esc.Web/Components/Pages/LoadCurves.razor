@page "/curvas"
@implements IAsyncDisposable
@inject EscBridgeService Bridge
@inject IJSRuntime JS
@using System.Globalization
@using System.Text

<PageTitle>ESC · Curvas de carga</PageTitle>

<main class="dashboard load-curves-page">
    <section class="topbar">
        <div>
            <p class="eyebrow">Identificacion de carga del agitador</p>
            <h1>Curvas de carga</h1>
        </div>
        <div class="topbar-actions">
            <div class="connection-state">
                <span>Barrido</span>
                <strong class="state-chip @StateChipClass">@StateText</strong>
            </div>
        </div>
    </section>

    <section class="startup-summary">
        <p>El firmware recorre la consigna en lazo cerrado y promedia cada punto (rpm, duty, tension y corriente de bus del INA219). Guarda o importa varias curvas para superponerlas y marca una como tara (p. ej. la pildora en aire) para ver cuanto agrega el fluido.</p>
        <span>@_result</span>
    </section>

    <div class="curves-grid">
        <section class="panel">
            <div class="panel-title">
                <h2>Barrido</h2>
                <span>@(Snapshot.ActiveSpeedLimits is { } l ? $"rango {l.MinRpm}–{l.MaxRpm} rpm" : "rango sin leer")</span>
            </div>
            <div class="sweep-form">
                <label>
                    <span>Modo</span>
                    <select @bind="_mode" disabled="@(!CanEdit)">
                        <option value="@LoadSweepMode.Staircase">Escalera</option>
                        <option value="@LoadSweepMode.Ramp">Rampa continua</option>
                    </select>
                </label>
                <label>
                    <span>Inicio <small>rpm</small></span>
                    <input type="number" min="0" step="50" @bind="_startRpm" disabled="@(!CanEdit)" />
                </label>
                <label>
                    <span>Fin <small>rpm</small></span>
                    <input type="number" min="0" step="50" @bind="_endRpm" disabled="@(!CanEdit)" />
                </label>
                <label>
                    <span>@(_mode == LoadSweepMode.Ramp ? "Pendiente" : "Escalon") <small>@(_mode == LoadSweepMode.Ramp ? "rpm/s" : "rpm")</small></span>
                    <input type="number" min="1" step="10" @bind="_stepOrRate" disabled="@(!CanEdit)" />
                </label>
                <label>
                    <span>Asentamiento <small>ms</small></span>
                    <input type="number" min="0" max="@CommConstants.LoadSweepMaxSettleMs" step="100" @bind="_settleMs" disabled="@(!CanEdit)" />
                </label>
                <label>
                    <span>Ventana <small>ms</small></span>
                    <input type="number" min="@CommConstants.LoadSweepMinWindowMs" max="@CommConstants.LoadSweepMaxWindowMs" step="100" @bind="_windowMs" disabled="@(!CanEdit)" />
                </label>
                <label class="checkbox">
                    <input type="checkbox" @bind="_stopAtEnd" disabled="@(!CanEdit)" />
                    <span>Detener el motor al terminar</span>
                </label>
            </div>
            <p class="hint">@PlanText</p>
            <div class="sweep-actions">
                <button class="primary" @onclick="StartAsync" disabled="@(!CanEdit)">Iniciar barrido</button>
                <button class="stop" @onclick="AbortAsync" disabled="@(_isBusy || !Sweep.Active)">Abortar</button>
                <button @onclick="RefreshAsync" disabled="@(_isBusy || !IsConnected)">Leer del MCU</button>
            </div>
        </section>

        <section class="panel">
            <div class="panel-title">
                <h2>Estado</h2>
                <span>@(Sweep.LastUpdatedAt?.ToLocalTime().ToString("HH:mm:ss", Inv) ?? "sin leer")</span>
            </div>
            <div class="kpi-grid">
                <div class="kpi kpi-wide"><span>Estado</span><strong class="state-chip @StateChipClass">@StateText</strong></div>
                <div class="kpi"><span>Puntos</span><strong>@Sweep.Points.Count<small> / @(Sweep.Status?.PointCount.ToString() ?? "-")</small></strong></div>
                <div class="kpi"><span>Objetivo</span><strong>@(Sweep.Status?.TargetRpm.ToString() ?? "-") <small>rpm</small></strong></div>
                <div class="kpi"><span>I bus reposo</span><strong>@IdleCurrentText <small>mA</small></strong></div>
                <div class="kpi"><span>Tiempo</span><strong>@ElapsedText <small>s</small></strong></div>
                <div class="kpi"><span>Velocidad</span><strong>@(Snapshot.Status?.ActualSpeedRpm.ToString() ?? "-") <small>rpm</small></strong></div>
                <div class="kpi"><span>Duty</span><strong>@(Snapshot.Status?.DutyPercent?.ToString("0.0", Inv) ?? "-") <small>%</small></strong></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Sweep.LastError))
            {
                <p class="result error">@Sweep.LastError</p>
            }
        </section>
    </div>

    <section class="panel">
        <div class="panel-title">
            <h2>Curvas</h2>
            <div class="curve-toolbar">
                <input class="curve-name" type="text" placeholder="Nombre (p. ej. agua 150 ml)" @bind="_saveLabel" />
                <button class="primary" @onclick="SaveCurrent" disabled="@(Sweep.Points.Count == 0)">Guardar curva actual</button>
                <label class="file-button">
                    Importar CSV
                    <InputFile OnChange="ImportAsync" accept=".csv" multiple />
                </label>
            </div>
        </div>
        <table class="curves-table">
            <thead>
                <tr><th>Ver</th><th></th><th>Curva</th><th>Origen</th><th>Puntos</th><th>Tara</th><th></th></tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="checkbox" checked="@_showCurrent" @onchange="ToggleCurrent" /></td>
                    <td><i class="swatch" style="background:@Palette[0]"></i></td>
                    <td>Actual (MCU)</td>
                    <td>barrido en curso / ultimo</td>
                    <td>@Sweep.Points.Count</td>
                    <td>-</td>
                    <td class="row-actions">
                        <button class="ghost" @onclick="ExportCurrentAsync" disabled="@(Sweep.Points.Count == 0)">CSV</button>
                        <button class="ghost" @onclick="ClearPoints" disabled="@(Sweep.Points.Count == 0 || Sweep.Active)">Limpiar</button>
                    </td>
                </tr>
                @for (int i = 0; i < Sweep.SavedCurves.Count; i++)
                {
                    SavedLoadCurve curve = Sweep.SavedCurves[i];
                    string color = ColorFor(i + 1);
                    <tr>
                        <td><input type="checkbox" checked="@(!_hidden.Contains(curve.Id))" @onchange="_ => ToggleSaved(curve.Id)" /></td>
                        <td><i class="swatch" style="background:@color"></i></td>
                        <td>@curve.Label</td>
                        <td>@curve.Source · @curve.CreatedAt.ToLocalTime().ToString("HH:mm", Inv)</td>
                        <td>@curve.Points.Count</td>
                        <td><input type="radio" name="tare" checked="@(Sweep.TareCurveId == curve.Id)" @onchange="_ => SetTare(curve.Id)" /></td>
                        <td class="row-actions">
                            <button class="ghost" @onclick="() => ExportSavedAsync(curve)">CSV</button>
                            <button class="ghost" @onclick="() => RemoveSaved(curve.Id)">Quitar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Sweep.TareCurve is not null)
        {
            <p class="hint">Tara: <strong>@Sweep.TareCurve.Label</strong>. <button class="link" @onclick="() => SetTare(null)">Sin tara</button></p>
        }
        else
        {
            <p class="hint">Marca una curva guardada como tara para restarla o para ver la corriente de carga.</p>
        }
    </section>

    <section class="panel">
        <div class="panel-title">
            <h2>Grafico</h2>
            <div class="curve-toolbar">
                <label>
                    Eje Y
                    <select @bind="_metric" @bind:after="RebuildCurves">
                        <option value="@LoadCurveMetric.BusCurrent">I bus [mA]</option>
                        <option value="@LoadCurveMetric.Duty">Duty [%]</option>
                        <option value="@LoadCurveMetric.BusPower">Potencia bus [W]</option>
                        <option value="@LoadCurveMetric.RpmStd">Dispersion de velocidad [rpm]</option>
                        <option value="@LoadCurveMetric.LoadCurrentVsTare" disabled="@(Sweep.TareCurve is null)">Corriente de carga vs tara [mA]</option>
                    </select>
                </label>
                <label class="checkbox">
                    <input type="checkbox" @bind="_subtractTare" @bind:after="RebuildCurves" disabled="@(Sweep.TareCurve is null || LoadCurveAnalysis.NeedsTare(_metric))" />
                    Restar tara
                </label>
            </div>
        </div>
        <div class="curve-legend">
            @foreach (Series series in _series)
            {
                <span><i class="legend-line" style="border-top-color:@series.Color"></i>@series.Label</span>
            }
        </div>
        <svg class="curve-plot" viewBox="0 0 @PlotWidth @PlotHeight" role="img" aria-label="Curvas de carga">
            <rect x="@MarginLeft" y="@MarginTop" width="@InnerWidth" height="@InnerHeight" class="plot-area" />
            @foreach (double tick in _xTicks)
            {
                <line x1="@F(MapX(tick))" x2="@F(MapX(tick))" y1="@MarginTop" y2="@(MarginTop + InnerHeight)" class="grid" />
                @SvgText(MapX(tick), MarginTop + InnerHeight + 16, "middle", tick.ToString("0", Inv))
            }
            @foreach (double tick in _yTicks)
            {
                <line x1="@MarginLeft" x2="@(MarginLeft + InnerWidth)" y1="@F(MapY(tick))" y2="@F(MapY(tick))" class="grid" />
                @SvgText(MarginLeft - 6, MapY(tick) + 4, "end", FormatTick(tick))
            }
            @if (_yMin < 0 && _yMax > 0)
            {
                <line x1="@MarginLeft" x2="@(MarginLeft + InnerWidth)" y1="@F(MapY(0))" y2="@F(MapY(0))" class="zero" />
            }
            @foreach (Series series in _series)
            {
                @if (series.Points.Count > 1)
                {
                    <polyline points="@Polyline(series.Points)" class="series" style="stroke:@series.Color" />
                }
                @foreach (LoadCurvePoint point in series.Points)
                {
                    <circle cx="@F(MapX(point.Rpm))" cy="@F(MapY(point.Value))" r="3" style="fill:@series.Color" />
                }
            }
            <text x="@(MarginLeft + InnerWidth / 2)" y="@(PlotHeight - 4)" class="axis-title" text-anchor="middle">Velocidad media [rpm]</text>
            <text x="12" y="@(MarginTop + InnerHeight / 2)" class="axis-title" text-anchor="middle" transform="rotate(-90 12 @(MarginTop + InnerHeight / 2))">@YAxisTitle</text>
        </svg>
        <p class="hint">@MetricHint</p>
    </section>

    <section class="panel">
        <div class="panel-title">
            <h2>Puntos de la curva actual</h2>
            <span>flags: 1 sin INA · 2 INA parcial · 4 duty saturado</span>
        </div>
        <div class="points-table-wrap">
            <table class="points-table">
                <thead>
                    <tr>
                        <th>#</th><th>Ref rpm</th><th>rpm</th><th>σ rpm</th><th>Duty %</th><th>σ duty %</th><th>V bus</th>
                        <th>I bus mA</th><th>σ I mA</th><th>P W</th><th>Flags</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (LoadSweepPoint point in Sweep.Points)
                    {
                        <tr class="@(point.Flags == LoadPointFlags.None ? null : "flagged")">
                            <td>@point.Index</td>
                            <td>@point.ReferenceRpm</td>
                            <td>@point.RpmMean</td>
                            <td>@point.RpmStd</td>
                            <td>@point.DutyPercent.ToString("0.00", Inv)</td>
                            <td>@point.DutyStdPercent.ToString("0.00", Inv)</td>
                            <td>@(point.HasPower ? point.BusVolts.ToString("0.00", Inv) : "-")</td>
                            <td>@(point.HasPower ? point.BusCurrentMa.ToString("0.0", Inv) : "-")</td>
                            <td>@(point.HasPower ? point.BusCurrentStdMa.ToString("0.0", Inv) : "-")</td>
                            <td>@(point.HasPower ? point.BusPowerWatts.ToString("0.000", Inv) : "-")</td>
                            <td>@((byte)point.Flags)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static readonly string[] Palette =
        ["#4f9dff", "#f0b44c", "#3ccf8e", "#f2555f", "#b48cff", "#ff8a4c", "#5fd3d3", "#d4dce6"];
    private const double PlotWidth = 760;
    private const double PlotHeight = 340;
    private const double MarginLeft = 64;
    private const double MarginRight = 16;
    private const double MarginTop = 14;
    private const double MarginBottom = 40;
    private const double InnerWidth = PlotWidth - MarginLeft - MarginRight;
    private const double InnerHeight = PlotHeight - MarginTop - MarginBottom;

    private sealed record Series(string Label, string Color, IReadOnlyList<LoadCurvePoint> Points);

    private BridgeSnapshot Snapshot { get; set; } = default!;
    private LoadSweepSnapshot Sweep => Snapshot.LoadSweep;

    private LoadSweepMode _mode = LoadSweepMode.Staircase;
    private int _startRpm = 1000;
    private int _endRpm = 3000;
    private int _stepOrRate = 250;
    private int _settleMs = 1500;
    private int _windowMs = 1000;
    private bool _stopAtEnd = true;

    private LoadCurveMetric _metric = LoadCurveMetric.BusCurrent;
    private bool _subtractTare;
    private bool _showCurrent = true;
    private readonly HashSet<Guid> _hidden = new();
    private string? _saveLabel;
    private List<Series> _series = new();
    private double[] _xTicks = Array.Empty<double>();
    private double[] _yTicks = Array.Empty<double>();
    private double _xMin, _xMax = 1, _yMin, _yMax = 1;

    private string _result = "Listo.";
    private bool _isBusy;
    private bool _disposed;
    private IJSObjectReference? _module;

    private bool IsConnected => Snapshot.State == DeviceConnectionState.Connected;
    private bool CanEdit => IsConnected && Snapshot.Mode == ControlMode.GuiControl && !Sweep.Active && !_isBusy;

    private string StateText => Sweep.Status is { } status
        ? status.State switch
        {
            LoadSweepState.Idle => "Sin barrido",
            LoadSweepState.MeasuringIdleCurrent => "Midiendo reposo",
            LoadSweepState.Starting => "Arrancando",
            LoadSweepState.Moving => "Moviendo consigna",
            LoadSweepState.Settling => "Asentando",
            LoadSweepState.Measuring => "Midiendo",
            LoadSweepState.Done => "Terminado",
            LoadSweepState.Aborted => $"Abortado: {AbortText(status.AbortReason)}",
            _ => status.State.ToString()
        }
        : "Sin datos";

    private string StateChipClass => Sweep.Status?.State switch
    {
        LoadSweepState.Done => "ok",
        LoadSweepState.Aborted => "bad",
        { } state when state is >= LoadSweepState.MeasuringIdleCurrent and <= LoadSweepState.Measuring => "warn",
        _ => string.Empty
    };

    private string IdleCurrentText => Sweep.Status is { IdleCurrentValid: true } status
        ? (status.IdleCurrentMicroamps / 1000.0).ToString("0.0", Inv)
        : "-";

    private string ElapsedText => Sweep.Status is { } status
        ? (status.ElapsedMs / 1000.0).ToString("0.0", Inv)
        : "-";

    private bool Subtracting => _subtractTare && Sweep.TareCurve is not null && !LoadCurveAnalysis.NeedsTare(_metric);

    private string YAxisTitle =>
        $"{(Subtracting ? "Δ " : string.Empty)}{MetricName(_metric)} [{LoadCurveAnalysis.Unit(_metric)}]";

    private string MetricHint => _metric switch
    {
        LoadCurveMetric.LoadCurrentVsTare =>
            "Corriente de carga = (I bus − I bus de la tara a la misma rpm) / duty. El consumo propio de la placa se cancela en la resta; dividir por el duty da la corriente extra en los bobinados, proporcional al torque extra.",
        LoadCurveMetric.RpmStd =>
            "La dispersion de velocidad sube cuando la pildora patina o se desengancha (el iman le da tirones).",
        LoadCurveMetric.Duty =>
            "El duty crece casi lineal con la velocidad por la BEMF; la carga aparece como una diferencia chica entre curvas.",
        _ => Subtracting
            ? "Diferencia contra la tara a igual velocidad (interpolada; fuera del rango de la tara no se dibuja)."
            : "Valores medidos promediados por ventana."
    };

    private string PlanText
    {
        get
        {
            int span = Math.Abs(_endRpm - _startRpm);
            if (_mode == LoadSweepMode.Staircase)
            {
                if (_stepOrRate <= 0) return "Defini un escalon mayor a cero.";
                int steps = (span + _stepOrRate - 1) / _stepOrRate + 1;
                double seconds = steps * (_settleMs + _windowMs) / 1000.0;
                return $"{steps} escalones · ~{seconds.ToString("0", Inv)} s sin contar el arranque ni la rampa entre escalones (limite 128).";
            }

            if (_stepOrRate <= 0 || span == 0) return "Defini una pendiente y rpm inicial/final distintas.";
            double rampSeconds = span / (double)_stepOrRate;
            int points = (int)(rampSeconds * 1000 / Math.Max(1, _windowMs)) + 1;
            return $"Rampa de {rampSeconds.ToString("0.0", Inv)} s · ~{points} puntos de {_windowMs} ms (limite 128).";
        }
    }

    protected override void OnInitialized()
    {
        Snapshot = Bridge.Snapshot;
        if (Snapshot.ActiveSpeedLimits is { } limits)
        {
            _startRpm = Math.Max(_startRpm, limits.MinRpm);
            _endRpm = Math.Min(_endRpm, limits.MaxRpm);
        }
        RebuildCurves();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Bridge.SnapshotChanged += HandleSnapshotChanged;
        if (IsConnected)
        {
            await RefreshAsync();
        }
    }

    private void HandleSnapshotChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            Snapshot = Bridge.Snapshot;
            RebuildCurves();
            StateHasChanged();
        });
    }

    private async Task StartAsync() => await BusyAsync(async () =>
    {
        var request = new LoadSweepRequest(
            _mode,
            ClampUShort(_startRpm),
            ClampUShort(_endRpm),
            ClampUShort(_stepOrRate),
            ClampUShort(_settleMs),
            ClampUShort(_windowMs),
            _stopAtEnd ? LoadSweepOptions.StopAtEnd : LoadSweepOptions.None);
        CommandResult result = await Bridge.StartLoadSweepAsync(request);
        _result = result.Message;
    });

    private async Task AbortAsync() => await BusyAsync(async () =>
    {
        CommandResult result = await Bridge.AbortLoadSweepAsync();
        _result = result.Message;
    });

    private async Task RefreshAsync() => await BusyAsync(async () =>
    {
        await Bridge.RefreshLoadSweepAsync();
    });

    private void SaveCurrent()
    {
        CommandResult result = Bridge.SaveCurrentLoadCurve(_saveLabel);
        _result = result.Message;
        if (result.Success) _saveLabel = null;
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        var messages = new List<string>();
        foreach (IBrowserFile file in args.GetMultipleFiles(16))
        {
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 1_000_000));
            string text = await reader.ReadToEndAsync();
            CommandResult result = Bridge.ImportLoadCurveCsv(Path.GetFileNameWithoutExtension(file.Name), text);
            messages.Add($"{file.Name}: {result.Message}");
        }
        _result = string.Join(" · ", messages);
    }

    private void ToggleCurrent(ChangeEventArgs args)
    {
        _showCurrent = args.Value is true;
        RebuildCurves();
    }

    private void ToggleSaved(Guid id)
    {
        if (!_hidden.Add(id)) _hidden.Remove(id);
        RebuildCurves();
    }

    private void SetTare(Guid? id)
    {
        Bridge.SetLoadCurveTare(id);
        if (id is null)
        {
            _subtractTare = false;
            if (LoadCurveAnalysis.NeedsTare(_metric)) _metric = LoadCurveMetric.BusCurrent;
        }
        _result = id is null ? "Sin tara." : "Tara actualizada.";
    }

    private void RemoveSaved(Guid id)
    {
        Bridge.RemoveSavedLoadCurve(id);
        _hidden.Remove(id);
    }

    private void ClearPoints()
    {
        Bridge.ClearLoadSweepPoints();
        _result = "Puntos del host borrados (la tabla del MCU no se toca).";
    }

    private async Task ExportCurrentAsync()
    {
        string mode = Sweep.Status?.Mode == LoadSweepMode.Ramp ? "rampa" : "escalera";
        await DownloadAsync($"curva-{mode}-{DateTime.Now:yyyyMMdd-HHmmss}.csv", Bridge.LoadSweepCsv());
    }

    private async Task ExportSavedAsync(SavedLoadCurve curve)
    {
        string? csv = Bridge.SavedLoadCurveCsv(curve.Id);
        if (csv is null) return;
        string safe = string.Concat(curve.Label.Select(c => char.IsLetterOrDigit(c) ? c : '-'));
        await DownloadAsync($"curva-{safe}.csv", csv);
    }

    private async Task DownloadAsync(string fileName, string csv)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/speed-chart.js");
        byte[] bytes = new UTF8Encoding(true).GetBytes(csv);
        await using var stream = new MemoryStream(bytes);
        using var streamReference = new DotNetStreamReference(stream);
        await _module.InvokeVoidAsync("downloadFileFromStream", fileName, streamReference);
    }

    private async Task BusyAsync(Func<Task> operation)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            await operation();
        }
        finally
        {
            _isBusy = false;
            Snapshot = Bridge.Snapshot;
            RebuildCurves();
        }
    }

    private static string ColorFor(int index) => Palette[index % Palette.Length];

    private void RebuildCurves()
    {
        if (Snapshot is null) return;
        SavedLoadCurve? tare = Sweep.TareCurve;
        if (LoadCurveAnalysis.NeedsTare(_metric) && tare is null)
        {
            _metric = LoadCurveMetric.BusCurrent;
        }

        bool relative = LoadCurveAnalysis.NeedsTare(_metric) || Subtracting;
        var candidates = new List<(string Label, string Color, IReadOnlyList<LoadSweepPoint> Points, Guid? Id)>();
        if (_showCurrent && Sweep.Points.Count > 0)
        {
            candidates.Add(("Actual (MCU)", ColorFor(0), Sweep.Points, null));
        }
        for (int i = 0; i < Sweep.SavedCurves.Count; i++)
        {
            SavedLoadCurve curve = Sweep.SavedCurves[i];
            if (_hidden.Contains(curve.Id)) continue;
            if (relative && curve.Id == tare?.Id) continue;
            candidates.Add((curve.Label + (curve.Id == tare?.Id ? " (tara)" : string.Empty), ColorFor(i + 1), curve.Points, curve.Id));
        }

        IReadOnlyList<LoadCurvePoint> tareCurve = tare is null
            ? Array.Empty<LoadCurvePoint>()
            : LoadCurveAnalysis.Curve(tare.Points, _metric == LoadCurveMetric.LoadCurrentVsTare ? LoadCurveMetric.BusCurrent : _metric);

        _series = candidates
            .Select(c => new Series(c.Label, c.Color, _metric switch
            {
                LoadCurveMetric.LoadCurrentVsTare => LoadCurveAnalysis.LoadCurrentVsTare(c.Points, tare!.Points),
                _ when Subtracting => LoadCurveAnalysis.Subtract(LoadCurveAnalysis.Curve(c.Points, _metric), tareCurve),
                _ => LoadCurveAnalysis.Curve(c.Points, _metric)
            }))
            .Where(series => series.Points.Count > 0)
            .ToList();

        LoadCurvePoint[] points = _series.SelectMany(series => series.Points).ToArray();
        if (points.Length == 0)
        {
            (_xMin, _xMax, _yMin, _yMax) = (0, 1000, 0, 1);
        }
        else
        {
            _xMin = points.Min(p => p.Rpm);
            _xMax = points.Max(p => p.Rpm);
            _yMin = Math.Min(0, points.Min(p => p.Value));
            _yMax = Math.Max(0, points.Max(p => p.Value));
            if (_xMax - _xMin < 1) { _xMin -= 50; _xMax += 50; }
            if (_yMax - _yMin < 1e-6) { _yMax = _yMin + 1; }
            double pad = (_yMax - _yMin) * 0.08;
            _yMax += pad;
            if (_yMin < 0) _yMin -= pad;
        }

        _xTicks = Ticks(_xMin, _xMax);
        _yTicks = Ticks(_yMin, _yMax);
    }

    private static double[] Ticks(double min, double max)
    {
        double span = max - min;
        double rough = span / 5;
        double magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        double step = new[] { 1, 2, 2.5, 5, 10 }.Select(f => f * magnitude).First(s => s >= rough);
        double first = Math.Ceiling(min / step) * step;
        var ticks = new List<double>();
        for (double tick = first; tick <= max + step * 1e-9; tick += step)
        {
            ticks.Add(Math.Round(tick, 9));
        }
        return ticks.ToArray();
    }

    private double MapX(double rpm) => MarginLeft + (rpm - _xMin) / (_xMax - _xMin) * InnerWidth;
    private double MapY(double value) => MarginTop + (1 - (value - _yMin) / (_yMax - _yMin)) * InnerHeight;

    private string Polyline(IReadOnlyList<LoadCurvePoint> points) =>
        string.Join(' ', points.Select(p => $"{F(MapX(p.Rpm))},{F(MapY(p.Value))}"));

    private static string F(double value) => value.ToString("0.##", Inv);

    // Razor reserves <text> inside code blocks, so tick labels are emitted as markup.
    private static MarkupString SvgText(double x, double y, string anchor, string label) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"tick\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(label)}</text>");

    private string FormatTick(double value) => _metric == LoadCurveMetric.BusPower
        ? value.ToString("0.##", Inv)
        : value.ToString("0.#", Inv);

    private static ushort ClampUShort(int value) => (ushort)Math.Clamp(value, 0, ushort.MaxValue);

    private static string MetricName(LoadCurveMetric metric) => metric switch
    {
        LoadCurveMetric.BusCurrent => "I bus",
        LoadCurveMetric.Duty => "Duty",
        LoadCurveMetric.BusPower => "P bus",
        LoadCurveMetric.RpmStd => "σ rpm",
        LoadCurveMetric.LoadCurrentVsTare => "Corriente de carga",
        _ => metric.ToString()
    };

    private static string AbortText(LoadSweepAbortReason reason) => reason switch
    {
        LoadSweepAbortReason.User => "usuario",
        LoadSweepAbortReason.MotorLost => "motor fuera de lazo cerrado",
        LoadSweepAbortReason.StartupTimeout => "timeout de arranque",
        LoadSweepAbortReason.TableFull => "tabla llena",
        LoadSweepAbortReason.Stopped => "STOP/ESTOP",
        _ => reason.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Bridge.SnapshotChanged -= HandleSnapshotChanged;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
