@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<main class="dashboard error-page">
    <section class="topbar">
        <div>
            <p class="eyebrow">APPLICATION ERROR</p>
            <h1 class="text-danger">No se pudo procesar la solicitud</h1>
        </div>
    </section>

    <section class="panel">
        @if (ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@RequestId</code></p>
        }

        <p>Para diagnosticar el error localmente, habilita el entorno <strong>Development</strong> y reinicia la aplicacion.</p>
        <p>No habilites <strong>Development</strong> en un despliegue: puede exponer informacion sensible de las excepciones.</p>
        <a class="nav-link" href="/">Volver al dashboard</a>
    </section>
</main>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
