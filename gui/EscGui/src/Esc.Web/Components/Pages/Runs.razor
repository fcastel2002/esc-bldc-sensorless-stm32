@page "/runs"
@inject ValidationRunService ValidationRuns
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Runs de validacion</PageTitle>

<main class="dashboard">
    <section class="topbar">
        <div>
            <p class="eyebrow">VALIDACION OFFLINE / MAT V7</p>
            <h1>Runs de simulacion</h1>
        </div>
    </section>

    <section class="panel">
        <div class="panel-title"><h2>Importar experimento</h2><span>CONTRATO esc_validation_v2 / MAT V7</span></div>
        <div class="control-grid">
            <label>Archivo MAT<InputFile OnChange="ImportAsync" accept=".mat" /></label>
            <label>Tolerancia PWM<input type="number" min="0" @bind="_tolerance" /></label>
            <label>Deadline (ms)<input type="number" min="1" max="2474" @bind="_deadlineMs" /></label>
            <label>Warm-up<input type="number" min="0" @bind="_warmupSamples" /></label>
            <label>Timeout MCU (ms, &gt; 2x deadline + 50)<input type="number" min="53" max="5000" @bind="_hilInputTimeoutMs" /></label>
        </div>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="result">@_message</p>
        }
    </section>

    <section class="panel">
        <div class="panel-title"><h2>Historial</h2><button @onclick="LoadAsync">Refrescar</button></div>
        @if (_runs.Count == 0)
        {
            <p>No hay runs importadas.</p>
        }
        else
        {
            <div class="table-wrap"><table>
                <thead><tr><th>Experimento</th><th>Estado</th><th>Muestras</th><th>Resultado</th><th>Creada</th><th></th></tr></thead>
                <tbody>
                @foreach (ValidationRunSummary run in _runs)
                {
                    <tr>
                        <td>
                            @if (_editingRunId == run.Id)
                            {
                                <div class="run-metadata-editor">
                                    <label>Nombre<input type="text" maxlength="@ValidationRunService.MaximumExperimentNameLength" @bind="_editedExperimentName" /></label>
                                    <label>Descripcion<textarea maxlength="@ValidationRunService.MaximumDescriptionLength" @bind="_editedDescription"></textarea></label>
                                </div>
                            }
                            else
                            {
                                <strong>@run.ExperimentName</strong><br /><small>@run.Description</small>
                            }
                        </td>
                        <td>@run.Status</td>
                        <td>@run.SampleCount</td>
                        <td>@run.PassedCount OK, @run.OutOfToleranceCount tolerancia, @run.TimeoutCount timeout</td>
                        <td>@run.CreatedAt.LocalDateTime.ToString("g")</td>
                        <td>
                            <div class="button-row compact-actions">
                                <a href="@($"/runs/{run.Id}")">Ver</a>
                                @if (_editingRunId == run.Id)
                                {
                                    <button class="primary" @onclick="() => SaveMetadataAsync(run.Id)" disabled="@_savingMetadata">
                                        @(_savingMetadata ? "Guardando..." : "Guardar")
                                    </button>
                                    <button @onclick="CancelMetadataEdit" disabled="@_savingMetadata">Cancelar</button>
                                }
                                else
                                {
                                    <button @onclick="() => BeginMetadataEdit(run)" disabled="@(_editingRunId is not null || _deletingRunId is not null)">Editar</button>
                                }
                                <button class="danger" @onclick="() => DeleteAsync(run)"
                                        disabled="@(run.Status == ValidationRunStatus.Running || _deletingRunId == run.Id || _editingRunId is not null)">
                                    @(_deletingRunId == run.Id ? "Eliminando..." : "Eliminar")
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</main>

@code {
    private IReadOnlyList<ValidationRunSummary> _runs = Array.Empty<ValidationRunSummary>();
    private ushort _tolerance;
    private int _deadlineMs = 100;
    private int _warmupSamples;
    private ushort _hilInputTimeoutMs = 500;
    private string? _message;
    private Guid? _deletingRunId;
    private Guid? _editingRunId;
    private string _editedExperimentName = string.Empty;
    private string _editedDescription = string.Empty;
    private bool _savingMetadata;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        ValidationRuns.ProgressChanged += HandleProgressChanged;
        await LoadAsync();
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        string temporaryPath = Path.Combine(Path.GetTempPath(), $"esc-validation-{Guid.NewGuid():N}.mat");
        try
        {
            await using (FileStream output = File.Create(temporaryPath))
            {
                await file.OpenReadStream(512L * 1024 * 1024).CopyToAsync(output);
            }
            ValidationRunSummary run = await ValidationRuns.ImportAsync(
                temporaryPath,
                new ValidationRunOptions(_tolerance, _deadlineMs, _warmupSamples, 0, _hilInputTimeoutMs));
            _message = $"Run {run.ExperimentName} importada con {run.SampleCount} muestras.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _message = $"No se pudo importar: {exception.Message}";
        }
        finally
        {
            if (File.Exists(temporaryPath))
            {
                File.Delete(temporaryPath);
            }
        }
    }

    private async Task LoadAsync()
    {
        IReadOnlyList<ValidationRunSummary> runs = await ValidationRuns.ListAsync();
        if (!_disposed)
        {
            _runs = runs;
        }
    }

    private async Task DeleteAsync(ValidationRunSummary run)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Eliminar la validacion '{run.ExperimentName}' y su archivo MAT? Esta accion no se puede deshacer.");
        if (!confirmed)
        {
            return;
        }

        _deletingRunId = run.Id;
        try
        {
            bool deleted = await ValidationRuns.DeleteAsync(run.Id);
            _message = deleted
                ? $"Validacion '{run.ExperimentName}' eliminada."
                : "La validacion ya no existe.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _message = $"No se pudo eliminar: {exception.Message}";
        }
        finally
        {
            _deletingRunId = null;
        }
    }

    private void BeginMetadataEdit(ValidationRunSummary run)
    {
        _editingRunId = run.Id;
        _editedExperimentName = run.ExperimentName;
        _editedDescription = run.Description;
        _message = null;
    }

    private void CancelMetadataEdit()
    {
        _editingRunId = null;
        _editedExperimentName = string.Empty;
        _editedDescription = string.Empty;
    }

    private async Task SaveMetadataAsync(Guid runId)
    {
        _savingMetadata = true;
        try
        {
            bool updated = await ValidationRuns.UpdateMetadataAsync(runId, _editedExperimentName, _editedDescription);
            _message = updated ? "Nombre y descripcion actualizados." : "La validacion ya no existe.";
            CancelMetadataEdit();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _message = $"No se pudieron actualizar los metadatos: {exception.Message}";
        }
        finally
        {
            _savingMetadata = false;
        }
    }

    private void HandleProgressChanged(object? sender, ValidationRunProgress progress)
    {
        _ = InvokeAsync(async () =>
        {
            if (!_disposed)
            {
                await LoadAsync();
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        ValidationRuns.ProgressChanged -= HandleProgressChanged;
    }
}
