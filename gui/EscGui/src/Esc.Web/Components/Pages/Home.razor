@page "/"
@implements IDisposable
@inject EscBridgeService Bridge
@inject ModularControlProvider ControlProvider
@inject IJSRuntime JS

<PageTitle>ESC · Dashboard</PageTitle>

<main class="dashboard">
    <section class="topbar">
        <div>
            <p class="eyebrow">Operacion en tiempo real</p>
            <h1>Control del motor</h1>
        </div>
        <p class="command-feedback" role="status" aria-live="polite">@_lastCommandResult</p>
    </section>

    <div class="dashboard-grid">
        <div class="dashboard-main">
            <section class="panel telemetry-panel collapsible-panel @(IsPanelCollapsed(PanelTelemetry) ? "is-collapsed" : null)">
                <div class="panel-title">
                    <div class="panel-heading">
                        <h2>Velocidad</h2>
                        <span>@Snapshot.SpeedTelemetry.SampleCount muestras · @Snapshot.SpeedTelemetry.EffectiveRateHz.ToString("0.0", Inv) Hz</span>
                    </div>
                    <div class="panel-heading-actions">
                        <button type="button" class="panel-toggle" aria-expanded="@(!IsPanelCollapsed(PanelTelemetry))" aria-controls="speed-acquisition-body" aria-label='@PanelToggleLabel(PanelTelemetry, "Velocidad")' @onclick="() => TogglePanelAsync(PanelTelemetry)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                        </button>
                    </div>
                </div>
                <div id="speed-acquisition-body" class="panel-body" hidden="@IsPanelCollapsed(PanelTelemetry)">
                    <div class="telemetry-toolbar">
                        <label>
                            Tasa
                            <input type="number" min="100" max="5000" step="50" @bind="_logRateMs" />
                            <span>ms</span>
                        </label>
                        <button @onclick="SetLogRateAsync" disabled="@(_isBusy || !IsConnected)">Aplicar tasa</button>
                        <span class="toolbar-spacer"></span>
                        @if (Snapshot.SpeedLoggingEnabled)
                        {
                            <button @onclick="StopSpeedLogAsync" disabled="@(_isBusy || !IsConnected)">Detener adquisicion</button>
                        }
                        else
                        {
                            <button class="primary" @onclick="StartSpeedLogAsync" disabled="@(_isBusy || !IsConnected)">Iniciar adquisicion</button>
                        }
                    </div>
                    <SpeedChart Samples="@_speedSamples"
                                SetpointRpm="@Snapshot.Status?.SpeedSetpointRpm"
                                ClearRequested="ClearSpeedTelemetry" />
                    <div class="telemetry-stats">
                        <span>Ultima: @(Snapshot.SpeedTelemetry.LastValue?.ToString("0.0", Inv) ?? "-") @Snapshot.SpeedTelemetry.Unit</span>
                        <span>Descartadas: @Snapshot.SpeedTelemetry.DroppedSamples</span>
                    </div>
                </div>
            </section>

            <section class="panel current-panel collapsible-panel @(IsPanelCollapsed(PanelCurrents) ? "is-collapsed" : null)">
                <div class="panel-title">
                    <div class="panel-heading">
                        <h2>Corrientes y BEMF</h2>
                        <span>IU @Snapshot.CurrentUTelemetry.SampleCount · IV @Snapshot.CurrentVTelemetry.SampleCount muestras</span>
                    </div>
                    <div class="panel-heading-actions">
                        <button type="button" class="panel-toggle" aria-expanded="@(!IsPanelCollapsed(PanelCurrents))" aria-controls="current-acquisition-body" aria-label='@PanelToggleLabel(PanelCurrents, "Corrientes y BEMF")' @onclick="() => TogglePanelAsync(PanelCurrents)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                        </button>
                    </div>
                </div>
                <div id="current-acquisition-body" class="panel-body" hidden="@IsPanelCollapsed(PanelCurrents)">
                    <div class="electrical-telemetry" aria-label="Corrientes sincronizadas y BEMF">
                        @ChannelCard(LogParam.CurrentU, "PA3 · SENSE_A", "Corriente IU", Snapshot.CurrentUTelemetry, Snapshot.CurrentULoggingEnabled, "mA", "iu")
                        @ChannelCard(LogParam.CurrentV, "PA4 · SENSE_B", "Corriente IV", Snapshot.CurrentVTelemetry, Snapshot.CurrentVLoggingEnabled, "mA", "iv")
                        @ChannelCard(LogParam.BemfPeriod, "TIM2 · LM339", "Periodo BEMF", Snapshot.BemfTelemetry, Snapshot.BemfLoggingEnabled, "ticks", "bemf")
                    </div>
                    <CurrentChart SamplesU="_currentUSamples"
                                  SamplesV="_currentVSamples"
                                  ClearRequested="ClearCurrentTelemetry" />
                </div>
            </section>
        </div>

        <aside class="dashboard-side">
            <section class="panel supply-panel collapsible-panel @(IsPanelCollapsed(PanelSupply) ? "is-collapsed" : null)">
                <div class="panel-title">
                    <div class="panel-heading">
                        <h2>Alimentacion</h2>
                        <span>INA219 · bus DC · @SupplyStateText</span>
                    </div>
                    <div class="panel-heading-actions">
                        <button type="button" class="panel-toggle" aria-expanded="@(!IsPanelCollapsed(PanelSupply))" aria-controls="supply-monitor-body" aria-label='@PanelToggleLabel(PanelSupply, "Alimentacion")' @onclick="() => TogglePanelAsync(PanelSupply)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                        </button>
                    </div>
                </div>
                <div id="supply-monitor-body" class="panel-body" hidden="@IsPanelCollapsed(PanelSupply)">
                    <div class="supply-readouts" aria-live="polite">
                        <div class="supply-reading voltage"><span>Voltaje</span><strong>@SupplyVoltageText <small>V</small></strong></div>
                        <div class="supply-reading current"><span>Corriente</span><strong>@SupplyCurrentText <small>@SupplyCurrentUnit</small></strong></div>
                        <div class="supply-reading power"><span>Potencia</span><strong>@SupplyPowerText <small>W</small></strong></div>
                    </div>
                    <p class="supply-state @SupplyStateClass">@SupplyStateDetail</p>
                    <div class="supply-telemetry">
                        @ChannelCard(LogParam.BusVoltage, "INA219 · VIN-", "Voltaje bus", Snapshot.BusVoltageTelemetry, Snapshot.BusVoltageLoggingEnabled, "mV", "vbus")
                        @ChannelCard(LogParam.BusCurrent, "INA219 · R100", "Corriente bus", Snapshot.BusCurrentTelemetry, Snapshot.BusCurrentLoggingEnabled, "mA", "ibus")
                    </div>
                    <p class="hint">Lectura en vivo via GET_STATUS (500 ms). La adquisicion por telemetria solo emite fuera de IDLE. Requiere transporte USB (PB6/PB7 compartidos con UART).</p>
                </div>
            </section>

            <section class="panel command-panel collapsible-panel @(IsPanelCollapsed(PanelPower) ? "is-collapsed" : null)">
                <div class="panel-title">
                    <h2>Marcha</h2>
                    <button type="button" class="panel-toggle" aria-expanded="@(!IsPanelCollapsed(PanelPower))" aria-controls="power-command-body" aria-label='@PanelToggleLabel(PanelPower, "Marcha")' @onclick="() => TogglePanelAsync(PanelPower)">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                    </button>
                </div>
                <div id="power-command-body" class="panel-body" hidden="@IsPanelCollapsed(PanelPower)">
                    <div class="action-grid">
                        <button class="run" @onclick="RunAsync" disabled="@(_isBusy || !CanSendControl)">RUN</button>
                        <button class="stop" @onclick="StopAsync" disabled="@(_isBusy || !CanSendControl)">STOP</button>
                    </div>
                    @foreach (var control in _controls.Where(IsSpeedSetpoint))
                    {
                        @ControlRow(control)
                    }
                    @if (Snapshot.Mode != ControlMode.GuiControl)
                    {
                        <p class="hint">@ModeHint</p>
                    }
                </div>
            </section>

            <section class="panel status-panel collapsible-panel @(IsPanelCollapsed(PanelStatus) ? "is-collapsed" : null)">
                <div class="panel-title">
                    <h2>Estado del ESC</h2>
                    <div class="panel-heading-actions">
                        <button class="ghost" @onclick="RefreshStatusAsync" disabled="@(_isBusy || !IsConnected)">Actualizar</button>
                        <button type="button" class="panel-toggle" aria-expanded="@(!IsPanelCollapsed(PanelStatus))" aria-controls="esc-status-body" aria-label='@PanelToggleLabel(PanelStatus, "Estado del ESC")' @onclick="() => TogglePanelAsync(PanelStatus)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                        </button>
                    </div>
                </div>
                <div id="esc-status-body" class="panel-body" hidden="@IsPanelCollapsed(PanelStatus)">
                    <div class="kpi-grid">
                        <div class="kpi kpi-wide"><span>Estado</span><strong class="state-chip @StateChipClass">@(Snapshot.Status?.AppStateName ?? "-")</strong></div>
                        <div class="kpi"><span>Setpoint</span><strong>@(Snapshot.Status?.SpeedSetpointRpm.ToString() ?? "-") <small>rpm</small></strong></div>
                        <div class="kpi"><span>Velocidad</span><strong>@(Snapshot.Status?.ActualSpeedRpm.ToString() ?? "-") <small>rpm</small></strong></div>
                        <div class="kpi"><span>Max PWM</span><strong>@(Snapshot.Status?.MaxPwm.ToString() ?? "-")</strong></div>
                        <div class="kpi"><span>Transporte</span><strong>@(Snapshot.Status?.Transport ?? "-")</strong></div>
                        <div class="kpi"><span>Stall</span><strong class="@FlagClass(Snapshot.Status?.MotorStalled, true)">@BoolText(Snapshot.Status?.MotorStalled)</strong></div>
                        <div class="kpi"><span>Cruces ZC</span><strong class="@FlagClass(Snapshot.Status?.ConsistentZeroCrossing, false)">@BoolText(Snapshot.Status?.ConsistentZeroCrossing)</strong></div>
                    </div>
                </div>
            </section>

            <section class="panel parameter-panel collapsible-panel @(IsPanelCollapsed(PanelParameters) ? "is-collapsed" : null)">
                <div class="panel-title">
                    <h2>Parametros</h2>
                    <button type="button" class="panel-toggle" aria-expanded="@(!IsPanelCollapsed(PanelParameters))" aria-controls="parameter-adjustment-body" aria-label='@PanelToggleLabel(PanelParameters, "Parametros")' @onclick="() => TogglePanelAsync(PanelParameters)">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
                    </button>
                </div>
                <div id="parameter-adjustment-body" class="panel-body" hidden="@IsPanelCollapsed(PanelParameters)">
                    @if (_controls.Count == 0 && !string.IsNullOrWhiteSpace(ControlProvider.LastError))
                    {
                        <p class="result error">@ControlProvider.LastError</p>
                    }
                    <div class="controls-list">
                        @foreach (var control in _controls.Where(control => !IsSpeedSetpoint(control)))
                        {
                            @ControlRow(control)
                        }
                    </div>
                    <p class="hint">Aplicar escribe en RAM; el disco guarda en flash (requiere IDLE).</p>
                </div>
            </section>
        </aside>
    </div>
</main>

@code {
    private const string PanelStorageKey = "esc.dashboard.panels.v1";
    private const string PanelStatus = "esc-status";
    private const string PanelPower = "power-command";
    private const string PanelParameters = "parameter-adjustment";
    private const string PanelTelemetry = "speed-acquisition";
    private const string PanelCurrents = "current-acquisition";
    private const string PanelSupply = "supply-monitor";
    private static readonly string[] KnownPanels =
        [PanelStatus, PanelPower, PanelParameters, PanelTelemetry, PanelCurrents, PanelSupply];
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private BridgeSnapshot Snapshot { get; set; } = default!;
    private IReadOnlyList<DashboardControl> _controls = Array.Empty<DashboardControl>();
    private IReadOnlyList<TelemetrySample> _speedSamples = Array.Empty<TelemetrySample>();
    private IReadOnlyList<TelemetrySample> _currentUSamples = Array.Empty<TelemetrySample>();
    private IReadOnlyList<TelemetrySample> _currentVSamples = Array.Empty<TelemetrySample>();
    private readonly Dictionary<string, double> _controlValues = new(StringComparer.OrdinalIgnoreCase);
    private ushort _logRateMs = 500;
    private readonly HashSet<string> _collapsedPanels = new(StringComparer.Ordinal);
    private string _lastCommandResult = "Listo.";
    private bool _isBusy;
    private bool _disposed;
    private bool _configLoaded;

    private bool IsConnected => Snapshot.State == DeviceConnectionState.Connected;
    private bool CanSendControl => IsConnected && Snapshot.Mode == ControlMode.GuiControl;
    private string StateChipClass => Snapshot.Status?.AppStateName switch
    {
        "CLOSEDLOOP" or "RUNNING" or "READY" => "ok",
        "FOC_STARTUP" or "SINE_DRIVE" or "STEP_TEST" or "CONFIG" => "warn",
        "HARD_ERROR" => "bad",
        _ => null
    } ?? string.Empty;
    private PowerMonitorReading? Supply => Snapshot.Status?.Power;
    private bool SupplyReadable => Supply is { Valid: true };
    private string SupplyVoltageText => SupplyReadable ? Supply!.BusVolts.ToString("0.00", Inv) : "-";
    private bool SupplyCurrentInAmps => SupplyReadable && Math.Abs(Supply!.CurrentAmps) >= 1.0;
    private string SupplyCurrentUnit => SupplyCurrentInAmps ? "A" : "mA";
    private string SupplyCurrentText => !SupplyReadable
        ? "-"
        : SupplyCurrentInAmps
            ? Supply!.CurrentAmps.ToString("0.000", Inv)
            : (Supply!.CurrentMicroamps / 1000.0).ToString("0.0", Inv);
    private string SupplyPowerText => SupplyReadable ? Supply!.PowerWatts.ToString("0.00", Inv) : "-";
    private string SupplyStateText => Supply switch
    {
        null => "sin datos",
        { Disabled: true } => "deshabilitado",
        { Present: false } => "no detectado",
        { Overflow: true } => "sobrerango",
        { Valid: true } => "OK",
        _ => "sin lectura"
    };
    private string SupplyStateClass => Supply switch
    {
        { Valid: true, Overflow: false } => "ok",
        { Valid: true, Overflow: true } => "warn",
        null => string.Empty,
        _ => "bad"
    };
    private string SupplyStateDetail => Supply switch
    {
        null when IsConnected => "El firmware no reporta INA219 (GET_STATUS de 10 bytes); actualice el firmware.",
        null => "Conecte el ESC para leer la alimentacion.",
        { Disabled: true } => "Transporte UART activo: PB6/PB7 son de USART1, el INA219 queda deshabilitado.",
        { Present: false } => $"INA219 no responde en I2C1 (PB6 SCL / PB7 SDA){SupplyErrorSuffix}; reintentando cada 1 s.",
        { Overflow: true } => $"INA219 0x{Supply.I2cAddress:X2}: sobrerango del shunt (> 320 mV / 3.2 A).",
        { Valid: true } => $"INA219 en 0x{Supply.I2cAddress:X2} · shunt 0.1 Ω · PGA ±320 mV · {Supply.ErrorCount} fallos I2C.",
        _ => $"INA219 en 0x{Supply.I2cAddress:X2}: fallo de lectura I2C{SupplyErrorSuffix}."
    };
    private string SupplyErrorSuffix => Supply is null || Supply.LastError == PowerMonitorError.None
        ? string.Empty
        : $" · ultimo error: {SupplyErrorText(Supply.LastError)} ({Supply.ErrorCount} fallos)";
    private static string SupplyErrorText(PowerMonitorError error) => error switch
    {
        PowerMonitorError.NotFound => "sin ACK en 0x40..0x4F (cableado, pull-ups o VCC)",
        PowerMonitorError.Nack => "NACK durante la transferencia",
        PowerMonitorError.Timeout => "timeout (SCL retenido o sin respuesta)",
        PowerMonitorError.Bus => "error de bus / arbitraje (ruido)",
        PowerMonitorError.Busy => "bus ocupado (SDA retenido en bajo)",
        _ => "error I2C"
    };
    private string ModeHint => Snapshot.Mode switch
    {
        ControlMode.SimulinkControl => "Modo Simulink: los comandos quedan reservados para Simulink salvo ESTOP.",
        ControlMode.MonitorOnly => "Modo monitoreo: solo adquisicion.",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        Snapshot = Bridge.Snapshot;
        _controls = await ControlProvider.GetControlsAsync();
        foreach (DashboardControl control in _controls)
        {
            _controlValues[control.Id] = control.DefaultValue;
        }

        if (IsConnected)
        {
            await LoadConfigValuesAsync();
        }

        _logRateMs = Snapshot.LogRateMs;
        _speedSamples = Bridge.SpeedSamples;
        _currentUSamples = Bridge.CurrentUSamples;
        _currentVSamples = Bridge.CurrentVSamples;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Bridge.SnapshotChanged += HandleSnapshotChanged;
        try
        {
            string? stored = await JS.InvokeAsync<string?>("localStorage.getItem", PanelStorageKey);
            string[]? collapsed = string.IsNullOrWhiteSpace(stored)
                ? null
                : System.Text.Json.JsonSerializer.Deserialize<string[]>(stored);
            if (collapsed is not null)
            {
                foreach (string panel in collapsed.Where(KnownPanels.Contains))
                {
                    _collapsedPanels.Add(panel);
                }
                StateHasChanged();
            }
        }
        catch
        {
            // Browser storage is optional; in-memory collapse still works.
        }
    }

    private void HandleSnapshotChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            Snapshot = Bridge.Snapshot;
            _speedSamples = Bridge.SpeedSamples;
            _currentUSamples = Bridge.CurrentUSamples;
            _currentVSamples = Bridge.CurrentVSamples;
            if (!IsConnected)
            {
                _configLoaded = false;
            }
            else if (!_configLoaded && !_isBusy)
            {
                // Conexion establecida desde la barra global: leer la config activa una vez.
                _configLoaded = true;
                await LoadConfigValuesAsync();
            }
            StateHasChanged();
        });
    }

    private async Task RefreshStatusAsync() => await BusyExecAsync(async () =>
    {
        await Bridge.RefreshStatusAsync();
        Snapshot = Bridge.Snapshot;
    });

    private async Task RunAsync() => await BusyExecAsync(() => StoreResultAsync(Bridge.RunAsync()));
    private async Task StopAsync() => await BusyExecAsync(() => StoreResultAsync(Bridge.StopAsync()));

    private async Task SetLogRateAsync() => await BusyExecAsync(async () =>
    {
        await StoreResultAsync(Bridge.SetLogRateAsync(_logRateMs));
    });

    private async Task StartSpeedLogAsync() => await BusyExecAsync(async () =>
    {
        await StoreResultAsync(Bridge.StartSpeedLogAsync());
    });

    private async Task StopSpeedLogAsync() => await BusyExecAsync(async () =>
    {
        await StoreResultAsync(Bridge.StopSpeedLogAsync());
    });

    private async Task StartLogAsync(LogParam parameter) => await BusyExecAsync(async () =>
    {
        await StoreResultAsync(Bridge.StartLogAsync(parameter));
    });

    private async Task StopLogAsync(LogParam parameter) => await BusyExecAsync(async () =>
    {
        await StoreResultAsync(Bridge.StopLogAsync(parameter));
    });

    private void ClearTelemetry(LogParam parameter)
    {
        Bridge.ClearTelemetry(parameter);
        Snapshot = Bridge.Snapshot;
        _lastCommandResult = $"Telemetria {parameter} limpiada; la adquisicion continua activa.";
    }

    private RenderFragment ChannelCard(LogParam parameter, string kicker, string title, TelemetryStats stats, bool enabled, string unit, string tone) => __builder =>
    {
        <article class="electrical-channel @tone">
            <div class="channel-head">
                <span class="channel-kicker">@kicker</span>
                <strong>@title</strong>
            </div>
            <div class="channel-reading">@(stats.LastValue?.ToString("0", Inv) ?? "-") <span>@unit</span></div>
            <small>@CurrentDetail(parameter, stats)</small>
            <div class="channel-actions">
                @if (enabled)
                {
                    <button @onclick="() => StopLogAsync(parameter)" disabled="@(_isBusy || !IsConnected)">Detener</button>
                }
                else
                {
                    <button class="primary" @onclick="() => StartLogAsync(parameter)" disabled="@(_isBusy || !IsConnected)">Iniciar</button>
                }
                <button class="ghost" @onclick="() => ClearTelemetry(parameter)" disabled="@(stats.SampleCount == 0)">Limpiar</button>
            </div>
        </article>
    };

    private RenderFragment ControlRow(DashboardControl control) => __builder =>
    {
        <div class="control-item">
            <div class="control-head">
                <label for="@control.Id">@control.Label</label>
                <span>@control.Unit</span>
            </div>
            @if (control.Kind.Equals("button", StringComparison.OrdinalIgnoreCase))
            {
                <button @onclick="() => ApplyControlAsync(control)" disabled="@ControlDisabled(control)">@control.Label</button>
            }
            else
            {
                @if (control.Kind.Equals("slider", StringComparison.OrdinalIgnoreCase))
                {
                    <input type="range" min="@ControlMin(control)" max="@ControlMax(control)" step="@control.Step" value="@FormatControlValue(control)" @onchange="args => UpdateControlValue(control, args)" disabled="@ControlDisabled(control)" aria-label="@control.Label" />
                }
                <div class="inline-input">
                    <div class="stepper">
                        <button type="button" class="step-button" @onclick="() => StepControl(control, -1)" disabled="@ControlDisabled(control)" aria-label="Disminuir @control.Label">−</button>
                        <input id="@control.Id" type="number" min="@ControlMin(control)" max="@ControlMax(control)" step="@control.Step" value="@FormatControlValue(control)" @onchange="args => UpdateControlValue(control, args)" disabled="@ControlDisabled(control)" />
                        <button type="button" class="step-button" @onclick="() => StepControl(control, 1)" disabled="@ControlDisabled(control)" aria-label="Aumentar @control.Label">+</button>
                    </div>
                    <button class="primary" @onclick="() => ApplyControlAsync(control)" disabled="@ControlDisabled(control)">Aplicar</button>
                    @if (CanPersistControl(control))
                    {
                        <button class="icon-button save-button" @onclick="() => SaveControlAsync(control)" disabled="@SaveControlDisabled(control)" title="Guardar en flash" aria-label="Guardar @control.Label en flash">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M5 3h12l2 2v16H5V3zm2 2v5h9V5H7zm1 11v3h8v-3H8zm8-11v4h1V6l-1-1z" />
                            </svg>
                        </button>
                    }
                </div>
            }
        </div>
    };

    private string CurrentDetail(LogParam parameter, TelemetryStats stats)
    {
        TelemetrySample? sample = Bridge.GetTelemetrySamples(parameter).LastOrDefault();
        if (sample is null) return $"{stats.SampleCount} muestras";
        string raw = sample.AdcRawValue.HasValue
            ? parameter switch
            {
                LogParam.BemfPeriod => $"periodo {sample.AdcRawValue.Value} ticks",
                LogParam.BusVoltage => "INA219",
                LogParam.BusCurrent => $"shunt {(short)sample.AdcRawValue.Value * 10} uV",
                _ => $"ADC {sample.AdcRawValue.Value}"
            }
            : "sin raw";
        string validity = parameter is LogParam.BusVoltage or LogParam.BusCurrent
            ? (sample.IsValid ? "presente" : "sin sensor")
            : sample.IsValid ? "valida" : "fuera de ventana";
        return $"{stats.SampleCount} muestras · {raw} · {validity}";
    }

    private void ClearSpeedTelemetry()
    {
        Bridge.ClearSpeedTelemetry();
        Snapshot = Bridge.Snapshot;
        _speedSamples = Bridge.SpeedSamples;
        _lastCommandResult = "Grafica de velocidad limpiada; la adquisicion continua activa.";
    }

    private void ClearCurrentTelemetry()
    {
        Bridge.ClearTelemetry(LogParam.CurrentU);
        Bridge.ClearTelemetry(LogParam.CurrentV);
        Snapshot = Bridge.Snapshot;
        _currentUSamples = Bridge.CurrentUSamples;
        _currentVSamples = Bridge.CurrentVSamples;
        _lastCommandResult = "Grafica de corrientes limpiada; la adquisicion continua activa.";
    }

    private async Task ApplyControlAsync(DashboardControl control) => await BusyExecAsync(async () =>
    {
        double value = ControlValue(control);
        Task<CommandResult> operation = control.Command switch
        {
            "set_speed_rpm" => Bridge.SetSpeedRpmAsync((int)Math.Round(value)),
            "set_config" when TryParseConfig(control.Param, out ConfigParam parameter) => Bridge.SetConfigAsync(parameter, value),
            "reset_config" when TryParseConfig(control.Param, out ConfigParam parameter) => Bridge.ResetConfigAsync(parameter),
            "log_speed_start" => Bridge.StartSpeedLogAsync(),
            "log_speed_stop" => Bridge.StopSpeedLogAsync(),
            _ => Task.FromResult(CommandResult.Failed($"Comando modular no soportado: {control.Command}."))
        };

        await StoreResultAsync(operation);
    });

    private async Task SaveControlAsync(DashboardControl control) => await BusyExecAsync(async () =>
    {
        if (!CanPersistControl(control) || !TryParseConfig(control.Param, out ConfigParam parameter))
        {
            _lastCommandResult = $"El control {control.Label} no tiene persistencia en flash.";
            return;
        }

        await StoreResultAsync(Bridge.SaveConfigAsync(parameter));
    });

    private async Task LoadConfigValuesAsync()
    {
        _configLoaded = true;
        foreach (DashboardControl control in _controls)
        {
            if (!CanPersistControl(control) || !TryParseConfig(control.Param, out ConfigParam parameter))
            {
                continue;
            }

            try
            {
                object? value = await Bridge.GetConfigAsync(parameter);
                if (value is not null)
                {
                    _controlValues[control.Id] = Convert.ToDouble(value, Inv);
                }
            }
            catch
            {
                _lastCommandResult = $"No se pudo leer {control.Label} desde el ESC.";
            }
        }

        Snapshot = Bridge.Snapshot;
    }

    private async Task BusyExecAsync(Func<Task> operation)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            await operation();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StoreResultAsync(Task<CommandResult> operation)
    {
        CommandResult result = await operation;
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
    }

    private void UpdateControlValue(DashboardControl control, ChangeEventArgs args)
    {
        if (double.TryParse(
            args.Value?.ToString(),
            System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture,
            out double value))
        {
            _controlValues[control.Id] = value;
        }
    }

    private void StepControl(DashboardControl control, int direction)
    {
        double step = control.Step > 0 ? control.Step : 1;
        double next = Math.Round(ControlValue(control) + direction * step, 6);
        _controlValues[control.Id] = Math.Clamp(next, ControlMin(control), Math.Max(ControlMin(control), ControlMax(control)));
    }

    private double ControlValue(DashboardControl control)
    {
        double value = _controlValues.TryGetValue(control.Id, out double currentValue) ? currentValue : control.DefaultValue;
        return IsSpeedSetpoint(control) && Snapshot.ActiveSpeedLimits is { } limits && limits.MinRpm <= limits.MaxRpm
            ? Math.Clamp(value, limits.MinRpm, limits.MaxRpm)
            : value;
    }

    private bool IsPanelCollapsed(string panel) => _collapsedPanels.Contains(panel);

    private string PanelToggleLabel(string panel, string title) =>
        $"{(IsPanelCollapsed(panel) ? "Restaurar" : "Minimizar")} {title}";

    private async Task TogglePanelAsync(string panel)
    {
        if (!KnownPanels.Contains(panel)) return;
        if (!_collapsedPanels.Add(panel))
        {
            _collapsedPanels.Remove(panel);
        }

        try
        {
            string json = System.Text.Json.JsonSerializer.Serialize(
                _collapsedPanels.Order(StringComparer.Ordinal));
            await JS.InvokeVoidAsync("localStorage.setItem", PanelStorageKey, json);
        }
        catch
        {
            // Keep the local state when storage is unavailable.
        }
    }

    private string FormatControlValue(DashboardControl control) =>
        ControlValue(control).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private double ControlMin(DashboardControl control) =>
        IsSpeedSetpoint(control) && Snapshot.ActiveSpeedLimits is { } limits ? limits.MinRpm : control.Min;

    private double ControlMax(DashboardControl control) =>
        IsSpeedSetpoint(control) && Snapshot.ActiveSpeedLimits is { } limits ? limits.MaxRpm : control.Max;

    private bool ControlDisabled(DashboardControl control)
    {
        if (!IsConnected)
        {
            return true;
        }

        if (control.RequiresIdle && Snapshot.Status?.AppState != 0)
        {
            return true;
        }

        if (IsSpeedSetpoint(control) && Snapshot.ActiveSpeedLimits is { } limits && limits.MinRpm > limits.MaxRpm)
        {
            return true;
        }

        return control.Command is not ("log_speed_start" or "log_speed_stop") && Snapshot.Mode != ControlMode.GuiControl;
    }

    private static bool CanPersistControl(DashboardControl control)
    {
        return control.Command is "set_config" or "reset_config";
    }

    private bool SaveControlDisabled(DashboardControl control) =>
        ControlDisabled(control) || Snapshot.Status?.AppState != 0;

    private static bool IsSpeedSetpoint(DashboardControl control) => control.Command == "set_speed_rpm";

    private static bool TryParseConfig(string? value, out ConfigParam parameter)
    {
        return Enum.TryParse(value, true, out parameter);
    }

    private static string BoolText(bool? value)
    {
        return value switch
        {
            true => "Si",
            false => "No",
            null => "-"
        };
    }

    private static string FlagClass(bool? value, bool trueIsBad) => value switch
    {
        true => trueIsBad ? "text-bad" : "text-ok",
        _ => string.Empty
    };

    public void Dispose()
    {
        _disposed = true;
        Bridge.SnapshotChanged -= HandleSnapshotChanged;
    }
}
