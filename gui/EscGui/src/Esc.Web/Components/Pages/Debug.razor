@page "/debug"
@implements IDisposable
@inject EscBridgeService Bridge
@inject IJSRuntime JS

<PageTitle>ESC · Debug</PageTitle>

<main class="dashboard debug-page">
    <section class="topbar">
        <div>
            <p class="eyebrow">Pruebas de potencia en lazo abierto</p>
            <h1>Debug</h1>
        </div>
        <p class="command-feedback" role="status" aria-live="polite">@_lastCommandResult</p>
    </section>

    <p class="safety-note">Sin limite de corriente ni temperatura en firmware. Ambas pruebas se detienen solas si el bridge deja de renovarlas (watchdog de 1,5 s), con STOP o con ESTOP.</p>

    <section class="panel step-panel">
        <div class="panel-title">
            <div class="panel-heading">
                <h2>Paso de conmutacion fijo</h2>
                <span>Mismo patron que la conmutacion six-step: primera fase en PWM, segunda a GND, tercera flotante</span>
            </div>
            <span class="badge @(Snapshot.StepTest.Active ? "active" : null)">@(Snapshot.StepTest.Active ? $"ACTIVO · {AppliedStepText}" : "DETENIDO")</span>
        </div>

        <div class="step-grid" role="radiogroup" aria-label="Paso de conmutacion">
            @foreach (CommutationStep step in Enum.GetValues<CommutationStep>())
            {
                CommutationStep captured = step;
                string name = step.ToString();
                <button type="button" role="radio" class="step-option @(_draftStep == step ? "selected" : null) @(IsAppliedStep(step) ? "applied" : null)" aria-checked="@(_draftStep == step)" @onclick="() => SelectStep(captured)" disabled="@(!CanEditStep)">
                    <span class="step-name">@name</span>
                    <span class="step-legs">
                        @foreach (char phase in "UVW")
                        {
                            <span class="leg @LegClass(name, phase)">@phase<small>@LegLabel(name, phase)</small></span>
                        }
                    </span>
                </button>
            }
        </div>

        <label class="duty-field">
            <span>Duty PWM</span>
            <input type="range" min="0" max="@FormatInvariant(CommConstants.MaxStepTestDutyPercent)" step="0.5" value="@FormatInvariant(_draftDuty)" @oninput="UpdateStepDuty" disabled="@(!CanEditStep)" />
            <strong>@_draftDuty.ToString("0.0", Inv) %</strong>
        </label>

        <div class="phase-footer">
            <div class="phase-readouts">
                <div><span>I bus</span><strong>@BusCurrentText <small>mA</small></strong></div>
                <div><span>V bus</span><strong>@BusVoltageText <small>V</small></strong></div>
            </div>
            <div class="phase-actions">
                <button class="primary" @onclick="ApplyStepTestAsync" disabled="@(!CanEditStep)">@(Snapshot.StepTest.Active ? "Aplicar cambios" : "Energizar")</button>
                <button @onclick="StopAsync" disabled="@(_isBusy || !CanSendControl)">Apagar</button>
            </div>
        </div>
        @if (_stepDraftDirty && Snapshot.StepTest.Active)
        {
            <p class="hint">Hay cambios sin aplicar.</p>
        }
    </section>

    <section class="panel sine-panel">
        <div class="panel-title">
            <div class="panel-heading">
                <h2>Lazo abierto sinusoidal</h2>
                <span>SPWM trifasica · frecuencia electrica</span>
            </div>
            <div class="panel-heading-actions">
                <div class="segmented compact" role="group" aria-label="Modo de aplicacion del lazo abierto">
                    <button type="button" class="@SineModeButtonClass(SineInteractionMode.Manual)" aria-pressed="@(_sineInteractionMode == SineInteractionMode.Manual)" @onclick="() => SetSineInteractionModeAsync(SineInteractionMode.Manual)">MANUAL</button>
                    <button type="button" class="@SineModeButtonClass(SineInteractionMode.Dynamic)" aria-pressed="@(_sineInteractionMode == SineInteractionMode.Dynamic)" @onclick="() => SetSineInteractionModeAsync(SineInteractionMode.Dynamic)">DINAMICO</button>
                </div>
                <span class="badge @(Snapshot.SineDrive.Active ? "active" : null)">@(Snapshot.SineDrive.Active ? "ACTIVO" : "DETENIDO")</span>
            </div>
        </div>
        <div class="sine-body">
            <div class="sine-control-grid">
                <label>
                    Frecuencia electrica
                    <input type="number" min="2" max="10" step="0.1" value="@FormatInvariant(_sineFrequencyHz)" @oninput="UpdateSineFrequency" disabled="@(_isBusy || !CanSendControl || Snapshot.StepTest.Active || Snapshot.Freewheel.Active)" />
                    <span>Hz</span>
                </label>
                <label>
                    Amplitud de modulacion
                    <input type="range" min="0" max="100" step="1" value="@FormatInvariant(_sineAmplitudePercent)" @oninput="UpdateSineAmplitudeDraft" @onchange="CommitSineAmplitude" disabled="@(_isBusy || !CanSendControl || Snapshot.StepTest.Active || Snapshot.Freewheel.Active)" />
                    <span>@_sineAmplitudePercent.ToString("0.#", Inv) %</span>
                </label>
            </div>
            <div class="sine-actions">
                @if (_sineInteractionMode == SineInteractionMode.Dynamic && Snapshot.SineDrive.Active)
                {
                    <button class="primary sine-auto-active" disabled>Actualizacion automatica</button>
                }
                else
                {
                    <button class="primary" @onclick="ApplySineDriveAsync" disabled="@(_isBusy || !CanSendControl || Snapshot.StepTest.Active || Snapshot.Freewheel.Active)">@(Snapshot.SineDrive.Active ? "Aplicar cambios" : "Iniciar lazo abierto")</button>
                }
                <button @onclick="StopAsync" disabled="@(_isBusy || !CanSendControl)">STOP</button>
                <span class="sine-sync-state @SineSyncClass">@SineSyncLabel</span>
            </div>
            <p class="sine-readback">@SineReadback</p>
        </div>
    </section>

    <section class="panel zc-panel">
        <div class="panel-title">
            <div class="panel-heading">
                <h2>Freewheel y diagnostico Zero Crossing</h2>
                <span>Sensado pasivo de comparadores BEMF (etapa de potencia apagada) y remapeo ZC por software</span>
            </div>
            <span class="badge @(Snapshot.Freewheel.Active ? "active" : null)">@(Snapshot.Freewheel.Active ? "FREEWHEEL · POTENCIA OFF" : "DETENIDO")</span>
        </div>

        <div class="zc-verdict @ZcVerdictClass" role="status">@ZcVerdictText</div>

        <div class="zc-channel-grid">
            @for (byte ch = 0; ch < 3; ch++)
            {
                byte hwCh = ch;
                bool isHigh = FreewheelReport?.IsPinHigh(hwCh) ?? false;
                bool isDead = FreewheelReport?.IsChannelDead(hwCh) ?? false;
                ushort edges = FreewheelReport?.EdgesForChannel(hwCh) ?? 0;
                string assignedPhase = EffectiveZcMap.PhaseForHardwareChannel(hwCh);
                <div class="zc-channel-card @(isDead ? "dead" : isHigh ? "high" : null)">
                    <div class="zc-channel-head">
                        <span class="zc-pin-name">@ZcChannelMap.HardwareChannelLabel(hwCh)</span>
                        <span class="zc-phase-pill">Fase @assignedPhase</span>
                    </div>
                    <div class="zc-channel-metrics">
                        <span class="zc-level @(isHigh ? "high" : "low")">@(FreewheelReport is null ? "-" : isHigh ? "HIGH" : "LOW")</span>
                        <strong>@edges <small>flancos</small></strong>
                    </div>
                    @if (isDead)
                    {
                        <span class="zc-dead-tag">SIN SEÑAL</span>
                    }
                </div>
            }
        </div>

        <div class="zc-stats-row">
            <div><span>RPM (mano)</span><strong>@(FreewheelReport?.EstimatedRpm.ToString(Inv) ?? "-")</strong></div>
            <div><span>Directos (U→V→W)</span><strong>@(FreewheelReport?.ForwardSteps.ToString(Inv) ?? "-")</strong></div>
            <div><span>Inversos (U→W→V)</span><strong>@(FreewheelReport?.ReverseSteps.ToString(Inv) ?? "-")</strong></div>
            <div><span>Invalidos</span><strong>@(FreewheelReport?.InvalidSteps.ToString(Inv) ?? "-")</strong></div>
            <div><span>Glitches</span><strong>@(FreewheelReport?.GlitchCount.ToString(Inv) ?? "-")</strong></div>
            <div><span>Asimetria</span><strong>@(FreewheelReport is { AvgStepTicks: > 0 } r ? $"{r.StepAsymmetryPct} %" : "-")</strong></div>
        </div>

        @if (FreewheelReport is { RecentEvents.Count: > 0 } reportWithEvents)
        {
            <div class="zc-sequence-strip">
                <span class="zc-seq-label">Ultimos 6 flancos:</span>
                <div class="zc-seq-chips">
                    @foreach (ZcRecentEvent ev in reportWithEvents.RecentEvents)
                    {
                        string phase = EffectiveZcMap.PhaseForHardwareChannel(ev.HardwareChannel);
                        string arrow = ev.IsRising ? "↑" : "↓";
                        <span class="zc-event-chip @(ev.IsRising ? "rising" : "falling")">@phase@arrow <small>@ZcChannelMap.HardwarePinShort(ev.HardwareChannel)</small></span>
                    }
                </div>
            </div>
        }

        <div class="phase-footer">
            <div class="phase-readouts">
                <div><span>Mapeo activo</span><strong>@EffectiveZcMap.FormatSummary()</strong></div>
            </div>
            <div class="phase-actions">
                <button class="primary" @onclick="StartFreewheelAsync" disabled="@(!CanStartFreewheel)">@(Snapshot.Freewheel.Active ? "Reiniciar conteo" : "Iniciar Freewheel")</button>
                <button @onclick="StopFreewheelAsync" disabled="@(_isBusy || !CanSendControl || !Snapshot.Freewheel.Active)">Detener Freewheel</button>
            </div>
        </div>

        <div class="zc-tools-grid">
            <div class="zc-subcard">
                <div class="zc-subcard-head">
                    <h3>Autodetectar correspondencia ZC ↔ Potencia</h3>
                    <span>Aplica un pulso breve (~15 ms por fase) con duty bajo para identificar que pin ZC corresponde a U, V y W.</span>
                </div>
                <label class="duty-field">
                    <span>Duty de sondeo</span>
                    <input type="range" min="@FormatInvariant(CommConstants.MinZcAutoDetectDutyPercent)" max="@FormatInvariant(CommConstants.MaxZcAutoDetectDutyPercent)" step="1" value="@FormatInvariant(_autoDetectDuty)" @oninput="UpdateAutoDetectDuty" disabled="@(!CanAutoDetectZc)" />
                    <strong>@_autoDetectDuty.ToString("0", Inv) %</strong>
                </label>
                <div class="zc-subcard-actions">
                    <button class="primary" @onclick="RunAutoDetectAsync" disabled="@(!CanAutoDetectZc)">Autodetectar mapeo ZC</button>
                    @if (Snapshot.Freewheel.LastAutoDetect is { HasDetectedMap: true, MatchesActiveMap: false } detectedToApply)
                    {
                        <button class="ghost" @onclick="ApplyDetectedZcMapAsync" disabled="@(!CanEditZcMap)">Aplicar detectado (@detectedToApply.DetectedMap!.FormatSummary())</button>
                    }
                </div>
                @if (Snapshot.Freewheel.LastAutoDetect is { } autoDetect)
                {
                    <div class="zc-detect-result">
                        <p class="zc-detect-summary">@DescribeAutoDetect(autoDetect)</p>
                        <table class="zc-matrix" aria-label="Matriz de respuesta de comparadores">
                            <thead>
                                <tr>
                                    <th>Excitando</th>
                                    <th>PA0 (CH1)</th>
                                    <th>PA1 (CH2)</th>
                                    <th>PB10 (CH3)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int p = 0; p < 3; p++)
                                {
                                    string probeName = p == 0 ? "Fase U" : p == 1 ? "Fase V" : "Fase W";
                                    <tr>
                                        <th>@probeName</th>
                                        @for (int ch = 0; ch < 3; ch++)
                                        {
                                            byte pct = autoDetect.HighPercent(p, ch);
                                            <td class="@(pct >= 65 ? "hot" : pct <= 35 ? "cold" : null)">@pct %</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="zc-subcard">
                <div class="zc-subcard-head">
                    <h3>Remapeo ZC por software (RAM / Flash)</h3>
                    <span>Permite corregir cables ZC cruzados sin resoldar ni recompilar. Guardar en Flash requiere estado IDLE.</span>
                </div>
                <div class="zc-map-selectors">
                    <label>
                        Fase U
                        <select value="@_draftZcU" @onchange="OnDraftZcUChanged" disabled="@(!CanEditZcMap)">
                            <option value="0">PA0 (CH1)</option>
                            <option value="1">PA1 (CH2)</option>
                            <option value="2">PB10 (CH3)</option>
                        </select>
                    </label>
                    <label>
                        Fase V
                        <select value="@_draftZcV" @onchange="OnDraftZcVChanged" disabled="@(!CanEditZcMap)">
                            <option value="0">PA0 (CH1)</option>
                            <option value="1">PA1 (CH2)</option>
                            <option value="2">PB10 (CH3)</option>
                        </select>
                    </label>
                    <label>
                        Fase W
                        <select value="@_draftZcW" @onchange="OnDraftZcWChanged" disabled="@(!CanEditZcMap)">
                            <option value="0">PA0 (CH1)</option>
                            <option value="1">PA1 (CH2)</option>
                            <option value="2">PB10 (CH3)</option>
                        </select>
                    </label>
                </div>
                @if (!DraftZcMap.IsValid)
                {
                    <p class="hint">Cada fase (U, V, W) debe tener un pin ZC distinto.</p>
                }
                <div class="zc-subcard-actions">
                    <button type="button" class="ghost" @onclick="SwapDraftZcUV" disabled="@(!CanEditZcMap)">Invertir U ↔ V</button>
                    <button class="primary" @onclick="ApplyDraftZcMapAsync" disabled="@(!CanEditZcMap || !DraftZcMap.IsValid)">Aplicar (RAM)</button>
                    <button @onclick="SaveZcMapFlashAsync" disabled="@(!CanAutoDetectZc)">Guardar en Flash</button>
                    <button type="button" class="ghost" @onclick="ResetZcMapAsync" disabled="@(!CanEditZcMap)">Defaults</button>
                </div>
            </div>
        </div>
    </section>
</main>

@code {
    private const string SineModeStorageKey = "esc.dashboard.sine-mode.v1";
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private BridgeSnapshot Snapshot { get; set; } = default!;
    private CommutationStep _draftStep = CommutationStep.UV;
    private double _draftDuty = 5.0;
    private bool _stepDraftDirty;
    private double _sineFrequencyHz = 2.0;
    private double _sineAmplitudePercent = 20.0;
    private double _autoDetectDuty = CommConstants.DefaultZcAutoDetectDutyPercent;
    private byte _draftZcU = ZcChannelMap.Default.ChannelU;
    private byte _draftZcV = ZcChannelMap.Default.ChannelV;
    private byte _draftZcW = ZcChannelMap.Default.ChannelW;
    private bool _zcDraftDirty;
    private bool _zcMapFetchedForConnection;
    private SineInteractionMode _sineInteractionMode = SineInteractionMode.Manual;
    private SineDynamicState _sineDynamicState = SineDynamicState.Idle;
    private SineDriveSettings? _lastSineRequestedSeen;
    private SineDriveSettings? _pendingDynamicSine;
    private CancellationTokenSource _dynamicSineCancellation = new();
    private CancellationTokenSource? _frequencyDebounceCancellation;
    private bool _sineDraftDirty;
    private bool _dynamicSineSendRunning;
    private string _lastCommandResult = "Listo.";
    private bool _isBusy;
    private bool _disposed;

    private bool IsConnected => Snapshot.State == DeviceConnectionState.Connected;
    private bool CanSendControl => IsConnected && Snapshot.Mode == ControlMode.GuiControl;
    private bool CanEditStep => !_isBusy && CanSendControl && !Snapshot.SineDrive.Active && !Snapshot.Freewheel.Active;
    private bool CanStartFreewheel => !_isBusy && CanSendControl && !Snapshot.SineDrive.Active && !Snapshot.StepTest.Active;
    private bool CanAutoDetectZc => !_isBusy && CanSendControl && !Snapshot.SineDrive.Active && !Snapshot.StepTest.Active && !Snapshot.Freewheel.Active;
    private bool CanEditZcMap => !_isBusy && CanSendControl && !Snapshot.SineDrive.Active && !Snapshot.StepTest.Active;
    private ZcDiagReport? FreewheelReport => Snapshot.Freewheel.Report;
    private ZcChannelMap EffectiveZcMap => Snapshot.Freewheel.ActiveMap ?? ZcChannelMap.Default;
    private ZcChannelMap DraftZcMap => new(_draftZcU, _draftZcV, _draftZcW);
    private string SineReadback => Snapshot.SineDrive.Applied is { } applied
        ? $"Aplicado por el MCU: {applied.ElectricalFrequencyHz.ToString("0.###", Inv)} Hz · {applied.AmplitudePercent.ToString("0.#", Inv)} %."
        : "Ajusta ambas consignas y activa la salida desde este panel.";
    private string SineSyncLabel => _sineInteractionMode == SineInteractionMode.Manual
        ? "MANUAL"
        : _sineDynamicState switch
        {
            SineDynamicState.Pending => "PENDIENTE",
            SineDynamicState.Applying => "APLICANDO",
            SineDynamicState.Synchronized => "SINCRONIZADO",
            SineDynamicState.Draft => "BORRADOR",
            SineDynamicState.Error => "ERROR",
            _ => Snapshot.SineDrive.Active ? "LISTO" : "EN ESPERA"
        };
    private string SineSyncClass => _sineInteractionMode == SineInteractionMode.Manual
        ? "manual"
        : _sineDynamicState.ToString().ToLowerInvariant();

    protected override void OnInitialized()
    {
        Snapshot = Bridge.Snapshot;
        SynchronizeSineDraftFromSnapshot(force: true);
        SynchronizeStepDraftFromSnapshot();
        SynchronizeZcDraftFromSnapshot(force: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Bridge.SnapshotChanged += HandleSnapshotChanged;
        if (IsConnected && Snapshot.Freewheel.ActiveMap is null)
        {
            _zcMapFetchedForConnection = true;
            _ = FetchZcMapSafeAsync();
        }
        try
        {
            string? storedSineMode = await JS.InvokeAsync<string?>("localStorage.getItem", SineModeStorageKey);
            if (Enum.TryParse(storedSineMode, ignoreCase: true, out SineInteractionMode storedMode) &&
                Enum.IsDefined(storedMode))
            {
                _sineInteractionMode = storedMode;
                _sineDynamicState = storedMode == SineInteractionMode.Dynamic && Snapshot.SineDrive.Active
                    ? SineDynamicState.Synchronized
                    : SineDynamicState.Idle;
                StateHasChanged();
            }
        }
        catch
        {
            // Manual remains the safe default when mode persistence is unavailable.
        }
    }

    private void HandleSnapshotChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            Snapshot = Bridge.Snapshot;
            if (!IsConnected)
            {
                _zcMapFetchedForConnection = false;
            }
            else if (!_zcMapFetchedForConnection && Snapshot.Freewheel.ActiveMap is null)
            {
                _zcMapFetchedForConnection = true;
                _ = FetchZcMapSafeAsync();
            }
            if (!Snapshot.SineDrive.Active || !CanSendControl)
            {
                if (_dynamicSineSendRunning || _pendingDynamicSine is not null) CancelDynamicSineQueue();
            }
            SynchronizeSineDraftFromSnapshot();
            SynchronizeStepDraftFromSnapshot();
            SynchronizeZcDraftFromSnapshot();
            StateHasChanged();
        });
    }

    // ---- Paso de conmutacion fijo ----------------------------------------------

    private void SelectStep(CommutationStep step)
    {
        _draftStep = step;
        _stepDraftDirty = true;
    }

    private void UpdateStepDuty(ChangeEventArgs args)
    {
        if (TryParseInvariant(args.Value, out double value))
        {
            _draftDuty = Math.Clamp(value, 0, CommConstants.MaxStepTestDutyPercent);
            _stepDraftDirty = true;
        }
    }

    private async Task ApplyStepTestAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.SetStepTestAsync(new StepTestSettings(_draftStep, _draftDuty));
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
        if (result.Success) _stepDraftDirty = false;
    });

    private void SynchronizeStepDraftFromSnapshot()
    {
        if (_stepDraftDirty || Snapshot.StepTest.Requested is not { } requested) return;
        _draftStep = requested.Step;
        _draftDuty = requested.DutyPercent;
    }

    private bool IsAppliedStep(CommutationStep step) =>
        Snapshot.StepTest.Active && Snapshot.StepTest.Applied?.Step == step;

    private string AppliedStepText => Snapshot.StepTest.Applied is { } applied
        ? $"{applied.Step} {applied.DutyPercent.ToString("0.0", Inv)} %"
        : string.Empty;

    // El nombre del paso es "<fase PWM><fase LOW>"; la restante queda flotante.
    private static string LegClass(string stepName, char phase) =>
        stepName[0] == phase ? "pwm" : stepName[1] == phase ? "low" : "float";

    private static string LegLabel(string stepName, char phase) =>
        stepName[0] == phase ? "PWM" : stepName[1] == phase ? "GND" : "flot.";

    // Con un paso fijo la corriente de bus del INA219 es d * I_fase (recirculacion por el lado bajo).
    private string BusCurrentText => Snapshot.Status?.Power is { Valid: true } power
        ? (power.CurrentMicroamps / 1000.0).ToString("0.0", Inv)
        : "-";

    private string BusVoltageText => Snapshot.Status?.Power is { Valid: true } power
        ? power.BusVolts.ToString("0.00", Inv)
        : "-";

    private async Task StopAsync() => await BusyExecAsync(async () =>
    {
        CancelDynamicSineQueue();
        CommandResult result = await Bridge.StopAsync();
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
        _sineDynamicState = SineDynamicState.Idle;
    });

    // ---- Lazo abierto sinusoidal ---------------------------------------------

    private async Task ApplySineDriveAsync() => await BusyExecAsync(async () =>
    {
        var settings = new SineDriveSettings(_sineFrequencyHz, _sineAmplitudePercent);
        CommandResult result = await Bridge.SetSineDriveAsync(
            settings.ElectricalFrequencyHz, settings.AmplitudePercent);
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
        if (result.Success && SineDraftMatches(settings))
        {
            _sineDraftDirty = false;
            SynchronizeSineDraftFromSnapshot();
            if (_sineInteractionMode == SineInteractionMode.Dynamic)
            {
                _sineDynamicState = SineDynamicState.Synchronized;
            }
        }
    });

    private void UpdateSineFrequency(ChangeEventArgs args)
    {
        if (TryParseInvariant(args.Value, out double value) && value is >= 2.0 and <= 10.0)
        {
            _sineFrequencyHz = value;
            _sineDraftDirty = true;
            ScheduleDynamicFrequencyApply();
        }
    }

    private void UpdateSineAmplitudeDraft(ChangeEventArgs args)
    {
        if (TryParseInvariant(args.Value, out double value))
        {
            _sineAmplitudePercent = Math.Clamp(value, 0.0, 100.0);
            _sineDraftDirty = true;
        }
    }

    private void CommitSineAmplitude(ChangeEventArgs args)
    {
        UpdateSineAmplitudeDraft(args);
        QueueDynamicSineApply();
    }

    private void SynchronizeSineDraftFromSnapshot(bool force = false)
    {
        if (Snapshot.SineDrive.Requested is not { } requested)
        {
            if (!Snapshot.SineDrive.Active) _lastSineRequestedSeen = null;
            return;
        }
        if (!force && (requested == _lastSineRequestedSeen || _sineDraftDirty)) return;

        _sineFrequencyHz = requested.ElectricalFrequencyHz;
        _sineAmplitudePercent = requested.AmplitudePercent;
        _lastSineRequestedSeen = requested;
        _sineDraftDirty = false;
    }

    private string SineModeButtonClass(SineInteractionMode mode) =>
        _sineInteractionMode == mode ? "active" : string.Empty;

    private async Task SetSineInteractionModeAsync(SineInteractionMode mode)
    {
        if (_sineInteractionMode == mode) return;
        _sineInteractionMode = mode;
        CancelDynamicSineQueue();
        _sineDynamicState = mode == SineInteractionMode.Dynamic && Snapshot.SineDrive.Active
            ? (_sineDraftDirty ? SineDynamicState.Draft : SineDynamicState.Synchronized)
            : SineDynamicState.Idle;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SineModeStorageKey, mode.ToString());
        }
        catch
        {
            // The selected mode still remains active for this browser session.
        }
    }

    private void QueueDynamicSineApply()
    {
        if (_sineInteractionMode != SineInteractionMode.Dynamic ||
            !Snapshot.SineDrive.Active ||
            !CanSendControl ||
            _disposed)
        {
            return;
        }

        _pendingDynamicSine = new SineDriveSettings(_sineFrequencyHz, _sineAmplitudePercent);
        _sineDynamicState = SineDynamicState.Pending;
        StartDynamicSineQueue();
    }

    private void ScheduleDynamicFrequencyApply()
    {
        _frequencyDebounceCancellation?.Cancel();
        _frequencyDebounceCancellation?.Dispose();
        _frequencyDebounceCancellation =
            CancellationTokenSource.CreateLinkedTokenSource(_dynamicSineCancellation.Token);
        _ = ApplyDynamicFrequencyAfterDelayAsync(_frequencyDebounceCancellation.Token);
    }

    private async Task ApplyDynamicFrequencyAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(80, cancellationToken);
            if (!_disposed) await InvokeAsync(QueueDynamicSineApply);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void StartDynamicSineQueue()
    {
        if (_dynamicSineSendRunning || _pendingDynamicSine is null) return;
        _dynamicSineSendRunning = true;
        _ = ProcessDynamicSineQueueAsync();
    }

    private async Task ProcessDynamicSineQueueAsync()
    {
        try
        {
            while (!_disposed &&
                   _sineInteractionMode == SineInteractionMode.Dynamic &&
                   Snapshot.SineDrive.Active &&
                   _pendingDynamicSine is { } settings)
            {
                _pendingDynamicSine = null;
                _sineDynamicState = SineDynamicState.Applying;
                CancellationToken dynamicCancellation = _dynamicSineCancellation.Token;
                if (_disposed) return;
                await InvokeAsync(StateHasChanged);

                CommandResult result = await Bridge.UpdateSineDriveAsync(
                    settings.ElectricalFrequencyHz,
                    settings.AmplitudePercent,
                    dynamicCancellation);
                if (_disposed) return;

                Snapshot = Bridge.Snapshot;
                _lastCommandResult = result.Message;
                if (!result.Success)
                {
                    _pendingDynamicSine = null;
                    _sineDynamicState = SineDynamicState.Error;
                    return;
                }

                if (SineDraftMatches(settings) && _pendingDynamicSine is null)
                {
                    _sineDraftDirty = false;
                    _lastSineRequestedSeen = Snapshot.SineDrive.Requested;
                    _sineDynamicState = SineDynamicState.Synchronized;
                }
                else
                {
                    _sineDynamicState = SineDynamicState.Pending;
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (!_disposed) _sineDynamicState = SineDynamicState.Idle;
        }
        catch (Exception exception)
        {
            if (!_disposed)
            {
                _lastCommandResult = exception.Message;
                _sineDynamicState = SineDynamicState.Error;
            }
        }
        finally
        {
            _dynamicSineSendRunning = false;
            if (!_disposed && _pendingDynamicSine is not null &&
                _sineInteractionMode == SineInteractionMode.Dynamic &&
                Snapshot.SineDrive.Active)
            {
                StartDynamicSineQueue();
            }
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private bool SineDraftMatches(SineDriveSettings settings) =>
        _sineFrequencyHz == settings.ElectricalFrequencyHz &&
        _sineAmplitudePercent == settings.AmplitudePercent;

    private void CancelDynamicSineQueue(bool renew = true)
    {
        _pendingDynamicSine = null;
        _frequencyDebounceCancellation?.Cancel();
        _frequencyDebounceCancellation?.Dispose();
        _frequencyDebounceCancellation = null;
        _dynamicSineCancellation.Cancel();
        _dynamicSineCancellation.Dispose();
        if (renew && !_disposed) _dynamicSineCancellation = new CancellationTokenSource();
    }

    // ---- Freewheel y diagnostico ZC -------------------------------------------

    private string ZcVerdictClass
    {
        get
        {
            if (FreewheelReport is not { } r) return "idle";
            if (r.HasDeadChannel || r.HealthFlags.HasFlag(ZcHealthFlags.NoiseOrInvalid)) return "error";
            if (r.HealthFlags.HasFlag(ZcHealthFlags.SequenceValid) && r.HealthFlags.HasFlag(ZcHealthFlags.DirectionForward)) return "ok";
            if (r.HealthFlags.HasFlag(ZcHealthFlags.SequenceValid) && r.HealthFlags.HasFlag(ZcHealthFlags.DirectionReverse)) return "warn";
            return "idle";
        }
    }

    private string ZcVerdictText
    {
        get
        {
            if (FreewheelReport is not { } r)
            {
                return "Activa Freewheel y gira el eje a mano para diagnosticar los 3 canales ZC sin energizar el puente.";
            }

            if (r.HasDeadChannel)
            {
                var dead = new List<string>(3);
                for (byte ch = 0; ch < 3; ch++)
                {
                    if (r.IsChannelDead(ch))
                    {
                        dead.Add($"{ZcChannelMap.HardwarePinShort(ch)} (Fase {EffectiveZcMap.PhaseForHardwareChannel(ch)})");
                    }
                }
                return $"Canal sin señal en {string.Join(", ", dead)}: revisar cableado, comparador o neutro virtual.";
            }

            if (r.HealthFlags.HasFlag(ZcHealthFlags.NoiseOrInvalid))
            {
                return "Ruido, glitches, estados invalidos (000/111) o secuencia fuera de orden detectada.";
            }

            if (r.HealthFlags.HasFlag(ZcHealthFlags.SequenceValid) && r.HealthFlags.HasFlag(ZcHealthFlags.DirectionForward))
            {
                return "Secuencia trifasica OK (U → V → W). Los 3 comparadores responden correctamente.";
            }

            if (r.HealthFlags.HasFlag(ZcHealthFlags.SequenceValid) && r.HealthFlags.HasFlag(ZcHealthFlags.DirectionReverse))
            {
                return "Secuencia invertida (U → W → V): si giras en sentido directo, hay dos canales ZC cruzados (podes corregir con Invertir U ↔ V o Autodetectar).";
            }

            if (r.HealthFlags.HasFlag(ZcHealthFlags.HasMotion))
            {
                return "Movimiento detectado; segui girando suavemente en un solo sentido para completar la secuencia de 6 flancos.";
            }

            return Snapshot.Freewheel.Active
                ? "Freewheel activo (potencia apagada). Gira el rotor a mano para medir los cruces por cero."
                : "Sin flancos suficientes registrados.";
        }
    }

    private static string DescribeAutoDetect(ZcAutoDetectResult result) => result.Status switch
    {
        ZcAutoDetectStatus.Ok when result.MatchesActiveMap =>
            $"OK: el cableado coincide con el mapeo activo ({result.DetectedMap!.FormatSummary()}).",
        ZcAutoDetectStatus.Ok =>
            $"Detectado: {result.DetectedMap!.FormatSummary()} (difiere del mapeo activo {result.ActiveMap.FormatSummary()}).",
        ZcAutoDetectStatus.OkInverted =>
            $"Detectado con polaridad invertida: {result.DetectedMap!.FormatSummary()}. Revisar etapa de comparadores.",
        ZcAutoDetectStatus.NoSignal =>
            "Sin señal en los comparadores (verificar alimentacion Vbus y neutro virtual).",
        _ =>
            "Respuesta ambigua entre fases (revisar cortos/cableado o ajustar el duty de sondeo)."
    };

    private async Task FetchZcMapSafeAsync()
    {
        try
        {
            await Bridge.GetZcMapAsync();
        }
        catch
        {
            // Ignore when disconnected or talking to older firmware without ZC_MAP.
        }
    }

    private void SynchronizeZcDraftFromSnapshot(bool force = false)
    {
        if (!force && _zcDraftDirty) return;
        ZcChannelMap map = EffectiveZcMap;
        _draftZcU = map.ChannelU;
        _draftZcV = map.ChannelV;
        _draftZcW = map.ChannelW;
    }

    private void UpdateAutoDetectDuty(ChangeEventArgs args)
    {
        if (TryParseInvariant(args.Value, out double value))
        {
            _autoDetectDuty = Math.Clamp(
                value,
                CommConstants.MinZcAutoDetectDutyPercent,
                CommConstants.MaxZcAutoDetectDutyPercent);
        }
    }

    private void OnDraftZcUChanged(ChangeEventArgs args)
    {
        if (byte.TryParse(args.Value?.ToString(), out byte value) && value < 3)
        {
            _draftZcU = value;
            _zcDraftDirty = true;
        }
    }

    private void OnDraftZcVChanged(ChangeEventArgs args)
    {
        if (byte.TryParse(args.Value?.ToString(), out byte value) && value < 3)
        {
            _draftZcV = value;
            _zcDraftDirty = true;
        }
    }

    private void OnDraftZcWChanged(ChangeEventArgs args)
    {
        if (byte.TryParse(args.Value?.ToString(), out byte value) && value < 3)
        {
            _draftZcW = value;
            _zcDraftDirty = true;
        }
    }

    private void SwapDraftZcUV()
    {
        (_draftZcU, _draftZcV) = (_draftZcV, _draftZcU);
        _zcDraftDirty = true;
    }

    private async Task StartFreewheelAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.StartFreewheelAsync();
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
        SynchronizeZcDraftFromSnapshot();
    });

    private async Task StopFreewheelAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.StopFreewheelAsync();
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
    });

    private async Task RunAutoDetectAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.RunZcAutoDetectAsync(_autoDetectDuty);
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
    });

    private async Task ApplyDetectedZcMapAsync()
    {
        if (Snapshot.Freewheel.LastAutoDetect?.DetectedMap is not { IsValid: true } detected) return;
        await BusyExecAsync(async () =>
        {
            CommandResult result = await Bridge.SetZcMapAsync(detected);
            _lastCommandResult = result.Message;
            Snapshot = Bridge.Snapshot;
            if (result.Success)
            {
                _zcDraftDirty = false;
                SynchronizeZcDraftFromSnapshot(force: true);
            }
        });
    }

    private async Task ApplyDraftZcMapAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.SetZcMapAsync(DraftZcMap);
        _lastCommandResult = result.Message;
        Snapshot = Bridge.Snapshot;
        if (result.Success)
        {
            _zcDraftDirty = false;
            SynchronizeZcDraftFromSnapshot(force: true);
        }
    });

    private async Task SaveZcMapFlashAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.SaveConfigAsync(ConfigParam.ZcMap);
        _lastCommandResult = result.Success ? "Mapeo ZC guardado en Flash." : result.Message;
        Snapshot = Bridge.Snapshot;
    });

    private async Task ResetZcMapAsync() => await BusyExecAsync(async () =>
    {
        CommandResult result = await Bridge.ResetConfigAsync(ConfigParam.ZcMap);
        await Bridge.GetZcMapAsync();
        _lastCommandResult = result.Success ? "Mapeo ZC restaurado a valores por defecto (RAM)." : result.Message;
        Snapshot = Bridge.Snapshot;
        _zcDraftDirty = false;
        SynchronizeZcDraftFromSnapshot(force: true);
    });

    // ---- Utilidades -----------------------------------------------------------

    private async Task BusyExecAsync(Func<Task> operation)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            await operation();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static bool TryParseInvariant(object? raw, out double value)
    {
        return double.TryParse(
            raw?.ToString(),
            System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture,
            out value);
    }

    private static string FormatInvariant(double value) =>
        value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _disposed = true;
        CancelDynamicSineQueue(renew: false);
        Bridge.SnapshotChanged -= HandleSnapshotChanged;
    }

    private enum SineInteractionMode
    {
        Manual,
        Dynamic
    }

    private enum SineDynamicState
    {
        Idle,
        Pending,
        Applying,
        Draft,
        Synchronized,
        Error
    }
}
