@inherits LayoutComponentBase
@implements IDisposable
@inject EscBridgeService Bridge

<div class="app-shell">
    <aside class="app-rail">
        <a class="brand" href="/" aria-label="ESC Console, ir al dashboard">
            <span class="brand-mark">EC</span>
            <span class="brand-copy">
                <span>STM32 / BLDC</span>
                <strong>ESC.CONSOLE</strong>
            </span>
        </a>

        <nav class="primary-nav" aria-label="Navegacion principal">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="nav-index">01</span>
                <span>Dashboard</span>
            </NavLink>
            <NavLink href="/runs">
                <span class="nav-index">02</span>
                <span>Validaciones</span>
            </NavLink>
            <NavLink href="/pil">
                <span class="nav-index">03</span>
                <span>PIL Monitor</span>
            </NavLink>
        </nav>

        <div class="rail-lower">
            <section class="rail-config" aria-label="Configuracion activa del ESC">
                <div class="rail-config-title">
                    <span>CONFIG MCU</span>
                    <button @onclick="RefreshReferenceAsync" disabled="@(_refreshing || _snapshot.State != DeviceConnectionState.Connected)" title="Actualizar configuracion">REF</button>
                </div>
                @if (_snapshot.ValidationReference is { } reference)
                {
                    <div class="rail-config-grid">
                        <span>KP/KI/KD</span><strong>@GainText</strong>
                        <span>CONTROL</span><strong>PI RPM V@reference.AlgorithmVersion</strong>
                        <span>POLOS</span><strong>@(_snapshot.ActiveControllerConfig?.PolePairs.ToString() ?? "-")</strong>
                        <span>PWM</span><strong>@reference.PwmFrequencyHz Hz</strong>
                        <span>ARR</span><strong>@reference.PwmArrCounts</strong>
                        <span>TIMER RPM</span><strong>@reference.SpeedTimerHz Hz</strong>
                        <span>PERIODO</span><strong>@reference.SpeedMaxPeriodTicks-@reference.SpeedMinPeriodTicks</strong>
                        <span>DT</span><strong>@reference.ControllerDtSeconds.ToString("0.000") s</strong>
                    </div>
                }
                else
                {
                    <p>@ReferenceState</p>
                }
            </section>
            <div class="rail-footer">
                <span class="status-led @_ledClass" aria-hidden="true"></span>
                <span>@_ledLabel</span>
            </div>
        </div>
    </aside>

    <div class="app-workspace">
        <header class="workspace-header">
            <span>CONTROL / TELEMETRIA / VALIDACION</span>
            <span>PANEL DE OPERACION</span>
        </header>
        <div class="page-content">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Se produjo un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _ledClass = "led-notdetected";
    private string _ledLabel = "SIN CONEXION";
    private BridgeSnapshot _snapshot = default!;
    private bool _refreshing;
    private bool _disposed;

    private string GainText => _snapshot.ActiveControllerConfig is { } config
        ? $"{config.Kp:0.00}/{config.Ki:0.00}/{config.Kd:0.00}"
        : "-/-/-";
    private string ReferenceState => _snapshot.State == DeviceConnectionState.Connected
        ? (_snapshot.ValidationReferenceError is null ? "SIN LEER" : "LECTURA FALLIDA")
        : "DESCONECTADO";

    protected override void OnInitialized()
    {
        _snapshot = Bridge.Snapshot;
        UpdateLed(_snapshot.State);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        Bridge.SnapshotChanged += HandleSnapshotChanged;
    }

    private void HandleSnapshotChanged(object? sender, EventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _snapshot = Bridge.Snapshot;
            UpdateLed(_snapshot.State);
            StateHasChanged();
        });
    }

    private async Task RefreshReferenceAsync()
    {
        _refreshing = true;
        try
        {
            await Bridge.RefreshValidationReferenceAsync();
        }
        catch
        {
            // El estado de error se publica en el snapshot del bridge.
        }
        finally
        {
            _refreshing = false;
        }
    }

    private void UpdateLed(DeviceConnectionState state)
    {
        (_ledClass, _ledLabel) = state switch
        {
            DeviceConnectionState.Connected => ("led-connected", "CONECTADO"),
            DeviceConnectionState.Detected => ("led-detected", "DETECTADO"),
            DeviceConnectionState.Connecting => ("led-connecting", "CONECTANDO"),
            DeviceConnectionState.Error => ("led-error", "ERROR"),
            DeviceConnectionState.Disconnected => ("led-error", "DESCONECTADO"),
            _ => ("led-notdetected", "SIN CONEXION")
        };
    }

    public void Dispose()
    {
        _disposed = true;
        Bridge.SnapshotChanged -= HandleSnapshotChanged;
    }
}
