@inherits LayoutComponentBase
@implements IDisposable
@inject EscBridgeService Bridge

<div class="app-shell">
    <aside class="app-rail">
        <a class="brand" href="/" aria-label="ESC Console, ir al dashboard">
            <span class="brand-mark">EC</span>
            <span class="brand-copy">
                <span>STM32 / BLDC</span>
                <strong>ESC.CONSOLE</strong>
            </span>
        </a>

        <nav class="primary-nav" aria-label="Navegacion principal">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="nav-index">01</span>
                <span>Dashboard</span>
            </NavLink>
            <NavLink href="/runs">
                <span class="nav-index">02</span>
                <span>Validaciones</span>
            </NavLink>
            <NavLink href="/pil">
                <span class="nav-index">03</span>
                <span>PIL Monitor</span>
            </NavLink>
        </nav>

        <div class="rail-footer">
            <span class="status-led @_ledClass" aria-hidden="true"></span>
            <span>@_ledLabel</span>
        </div>
    </aside>

    <div class="app-workspace">
        <header class="workspace-header">
            <span>CONTROL / TELEMETRY / VALIDATION</span>
            <span>OPERATOR PANEL</span>
        </header>
        <div class="page-content">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Se produjo un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _ledClass = "led-notdetected";
    private string _ledLabel = "SIN CONEXION";

    protected override void OnInitialized()
    {
        UpdateLed(Bridge.Snapshot.State);
        Bridge.SnapshotChanged += HandleSnapshotChanged;
    }

    private void HandleSnapshotChanged(object? sender, EventArgs args)
    {
        UpdateLed(Bridge.Snapshot.State);
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateLed(DeviceConnectionState state)
    {
        (_ledClass, _ledLabel) = state switch
        {
            DeviceConnectionState.Connected => ("led-connected", "CONECTADO"),
            DeviceConnectionState.Detected => ("led-detected", "DETECTADO"),
            DeviceConnectionState.Connecting => ("led-connecting", "CONECTANDO"),
            DeviceConnectionState.Error => ("led-error", "ERROR"),
            DeviceConnectionState.Disconnected => ("led-error", "DESCONECTADO"),
            _ => ("led-notdetected", "SIN CONEXION")
        };
    }

    public void Dispose()
    {
        Bridge.SnapshotChanged -= HandleSnapshotChanged;
    }
}
